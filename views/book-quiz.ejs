<% var pageTitle='Bài tự luyện - '+lesson.title %><%- include('partials/header') %>
<div class="card border-0 shadow-sm p-4"><div class="d-flex justify-content-between align-items-center"><div><div class="small text-muted">Sách · Tự luyện</div><h3 class="fw-bold"><%=quiz?quiz.title:'Bài tự luyện'%></h3><div class="text-muted"><%=lesson.title%></div></div><a href="/sach/hoc/<%=lesson.id%>" class="btn btn-outline-secondary">← Quay lại bài học</a></div>
<%if(!quiz){%><div class="alert alert-info mt-4">Giáo viên chưa tạo bài tự luyện cho bài này.</div><%}else{%><%if(result){%><div class="alert <%=result.passed?'alert-success':'alert-warning'%> mt-4"><b>Kết quả: <%=result.score%>/10</b> — đúng <%=result.correct%>/<%=result.total%> câu. <%=result.passed?'Bạn đã đạt.':'Bạn có thể xem lại bài và làm lại.'%></div><%}%><form method="post" action="/sach/hoc/<%=lesson.id%>/tu-luyen"><%quiz.questions.forEach((q,i)=>{%><div class="border rounded-3 p-3 mb-3"><div class="fw-semibold mb-2">Câu <%=i+1%>. <%=q.question%></div><%q.options.forEach((o,j)=>{%><label class="d-block p-2 rounded border mb-2"><input type="radio" name="q_<%=q.id%>" value="<%=o.id%>" required> <%=String.fromCharCode(65+j)%>. <%=o.option_text%></label><%})%></div><%})%><%if(!quiz.questions.length){%><div class="text-muted">Bài tự luyện chưa có câu hỏi.</div><%}else{%><button class="btn btn-primary px-4">Nộp bài</button><%}%></form><%}%></div>
<%- include('partials/footer') %>
