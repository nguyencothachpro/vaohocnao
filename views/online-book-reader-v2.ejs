<% var pageTitle = 'Đọc: ' + book.title %>
<%- include('partials/header') %>
<div class="reader-shell">
  <div class="reader-header"><div><h5 class="fw-bold mb-0"><%=book.title%></h5><div class="small text-muted">Sách lật · zoom · mục lục · note · bút · đánh dấu</div></div><div class="reader-tools"><button id="tocBtn" class="reader-btn">☰ Mục lục</button><button id="prevBtn" class="reader-btn">←</button><label class="reader-page"><input id="pageInput" type="number" min="1" value="1"><span>/ <b id="totalPages">1</b></span></label><button id="nextBtn" class="reader-btn">→</button><button id="zoomOut" class="reader-btn">−</button><span id="zoomLabel">100%</span><button id="zoomIn" class="reader-btn">+</button><button id="fitBtn" class="reader-btn">Fit</button><button id="rotateBtn" class="reader-btn">↻</button><button id="fullscreenBtn" class="reader-btn">⛶</button></div></div>
  <div class="reader-body"><aside id="tocPanel" class="reader-panel d-none"><div class="d-flex justify-content-between mb-2"><b>MỤC LỤC</b><button id="tocClose" class="btn-close"></button></div><div id="tocList"></div></aside><main id="readerStage" class="reader-stage"><div id="flipbook"></div><div id="readerLoading" class="reader-loading"><div class="spinner-border spinner-border-sm"></div><div class="mt-2">Đang tải sách...</div></div></main><aside class="reader-actions"><div class="action-title">CÔNG CỤ</div><button id="bookmarkBtn" class="action-btn">🔖 Đánh dấu trang</button><button id="noteBtn" class="action-btn">📝 Ghi chú</button><button id="penBtn" class="action-btn">✎ Viết lên trang</button><button id="highlightBtn" class="action-btn">🖍 Đánh dấu</button><button id="clearInkBtn" class="action-btn">⌫ Xóa nét</button><div id="bookmarkStatus" class="small text-success mt-2"></div><hr><div class="small text-muted">Nét viết và ghi chú chỉ là lớp chú thích của bạn, không thay đổi file PDF gốc.</div></aside></div>
  <div id="notePanel" class="note-panel d-none"><div class="d-flex justify-content-between"><b>Ghi chú trang <span id="notePage">1</span></b><button id="noteClose" class="btn-close"></button></div><textarea id="noteText" placeholder="Ghi công thức, ý chính, câu hỏi..."></textarea><button id="saveNote" class="btn btn-primary btn-sm">Lưu ghi chú</button></div>
</div>
<style>
.reader-shell{background:#f1f5f9;border:1px solid #e2e8f0;border-radius:14px;overflow:hidden;min-height:calc(100vh - 130px);position:relative}.reader-header{background:#fff;border-bottom:1px solid #e2e8f0;padding:10px 14px;display:flex;justify-content:space-between;align-items:center;gap:12px}.reader-tools{display:flex;align-items:center;gap:5px;flex-wrap:wrap}.reader-btn{border:1px solid #cbd5e1;background:#fff;border-radius:7px;padding:6px 9px;font-size:12px}.reader-page{display:flex;align-items:center;gap:3px;font-size:12px}.reader-page input{width:48px;border:1px solid #cbd5e1;border-radius:6px;padding:5px;text-align:center}.reader-body{height:calc(100vh - 205px);min-height:560px;display:grid;grid-template-columns:260px minmax(0,1fr) 190px;position:relative}.reader-stage{position:relative;overflow:auto;background:radial-gradient(circle at center,#f8fafc,#dbe3ed);display:flex;justify-content:center;align-items:flex-start;padding:30px}.reader-stage>#flipbook{width:720px;transform-origin:center top;transition:transform .15s ease}.reader-panel{position:absolute;left:0;top:0;bottom:0;width:260px;background:#fff;z-index:30;padding:14px;border-right:1px solid #e2e8f0;overflow:auto;box-shadow:10px 0 25px rgba(15,23,42,.08)}.reader-panel.d-none{display:none!important}.toc-row{display:block;width:100%;text-align:left;border:0;background:#fff;padding:8px 5px;border-bottom:1px solid #f1f5f9}.toc-row:hover{background:#eff6ff}.reader-actions{background:#fff;border-left:1px solid #e2e8f0;padding:12px}.action-title{font-size:10px;color:#64748b;font-weight:800;margin-bottom:8px}.action-btn{width:100%;text-align:left;border:1px solid #e2e8f0;background:#fff;border-radius:8px;padding:9px 8px;margin-bottom:6px;font-size:12px}.action-btn.active{background:#eff6ff;border-color:#93c5fd}.note-panel{position:absolute;right:205px;top:70px;width:330px;background:#fff;border:1px solid #cbd5e1;border-radius:10px;padding:12px;z-index:50;box-shadow:0 15px 40px rgba(15,23,42,.2)}.note-panel textarea{width:100%;min-height:180px;margin:10px 0;padding:9px;border:1px solid #cbd5e1;border-radius:8px}.reader-loading{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#64748b;background:rgba(241,245,249,.86);z-index:20}.storypage{background:#fdfaf3;width:100%;height:100%;overflow:hidden}.storypage-inner{padding:28px;height:100%;overflow:auto;line-height:1.7}.pdfpage{position:relative;background:#fff;display:flex;align-items:center;justify-content:center}.pdf-canvas{width:100%;height:100%;display:block}.ink-layer{position:absolute;inset:0;width:100%;height:100%;touch-action:none}.reader-stage.ink-mode .ink-layer,.reader-stage.highlight-mode .ink-layer{cursor:crosshair}@media(max-width:1100px){.reader-body{grid-template-columns:1fr}.reader-actions{display:none}.reader-header{align-items:flex-start;flex-direction:column}.reader-stage{height:calc(100vh - 260px)}}
</style>
<script src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.js"></script><script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>
(async()=>{const mode=<%-JSON.stringify(mode)%>,slug=<%-JSON.stringify(book.slug)%>,unlocked=<%-unlocked?'true':'false'%>,flipEl=document.getElementById('flipbook'),stage=document.getElementById('readerStage'),loading=document.getElementById('readerLoading');let flip=null,pages=[],current=0,zoom=1,rotation=0,ink=false,highlight=false;const storeKey='reader:'+slug,store=JSON.parse(localStorage.getItem(storeKey)||'{}');
function zoomUI(){flipEl.style.transform=`scale(${zoom}) rotate(${rotation}deg)`;document.getElementById('zoomLabel').textContent=Math.round(zoom*100)+'%'}function page(n){current=Math.max(0,Math.min(pages.length-1,Number(n)||0));try{flip?.flip(current)}catch(e){}document.getElementById('pageInput').value=current+1;document.getElementById('notePage').textContent=current+1;loadNote()}
function inkLayer(host){const c=document.createElement('canvas');c.className='ink-layer';host.appendChild(c);const resize=()=>{const r=host.getBoundingClientRect();if(!r.width||!r.height)return;c.width=r.width*devicePixelRatio;c.height=r.height*devicePixelRatio;c.style.width=r.width+'px';c.style.height=r.height+'px'};if(window.ResizeObserver)new ResizeObserver(resize).observe(host);resize();let down=false,last=null;c.onpointerdown=e=>{if(!ink&&!highlight)return;c.setPointerCapture(e.pointerId);down=true;last=[e.offsetX,e.offsetY]};c.onpointerup=()=>{down=false;last=null};c.onpointermove=e=>{if(!down)return;const x=c.getContext('2d');x.save();x.scale(devicePixelRatio,devicePixelRatio);x.lineCap='round';x.lineWidth=highlight?18:3;x.strokeStyle=highlight?'rgba(250,204,21,.35)':'#ef4444';x.beginPath();x.moveTo(last[0],last[1]);x.lineTo(e.offsetX,e.offsetY);x.stroke();x.restore();last=[e.offsetX,e.offsetY]};return c}
function toc(entries){const el=document.getElementById('tocList');el.innerHTML='';entries.forEach(e=>{const b=document.createElement('button');b.className='toc-row';b.textContent=e.title+(e.locked?' 🔒':'');b.onclick=()=>e.locked?location.href='/doc-sach-online/'+slug:page(e.pageIndex);el.appendChild(b)})}
try{if(mode==='chapters'){const src=document.querySelectorAll('#pageSource .storypage');pages=[...src];flipEl.innerHTML='';pages.forEach(p=>{flipEl.appendChild(p);inkLayer(p)});flip=new St.PageFlip(flipEl,{width:720,height:1018,size:'stretch',minWidth:280,maxWidth:1000,minHeight:390,maxHeight:1400,showCover:true});flip.loadFromHTML(pages);flip.on('flip',e=>page(e.data));toc(<%-JSON.stringify((chapters||[]).map((c,i)=>({title:'Chương '+(i+1)+': '+c.title,pageIndex:i,locked:!c.unlocked})))%>)}else{pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';const pdf=await pdfjsLib.getDocument('/doc-sach-online/'+slug+'/file').promise,total=pdf.numPages,limit=unlocked?total:Math.min(3,total);for(let i=1;i<=limit;i++){const p=await pdf.getPage(i),vp=p.getViewport({scale:1.5}),wrap=document.createElement('div');wrap.className='storypage pdfpage';const c=document.createElement('canvas');c.className='pdf-canvas';c.width=vp.width;c.height=vp.height;await p.render({canvasContext:c.getContext('2d'),viewport:vp}).promise;wrap.appendChild(c);inkLayer(wrap);flipEl.appendChild(wrap);pages.push(wrap)}const manual=<%-JSON.stringify((manualToc||[]).map(e=>({title:e.title,pageNumber:e.page_number})))%>;const entries=manual.map(e=>({title:e.title,pageIndex:Math.max(0,(e.pageNumber||1)-1),locked:!unlocked&&e.pageNumber>limit}));toc(entries);flip=new St.PageFlip(flipEl,{width:720,height:1018,size:'stretch',minWidth:280,maxWidth:1000,minHeight:390,maxHeight:1400,showCover:true});flip.loadFromHTML(pages);flip.on('flip',e=>{current=e.data;document.getElementById('pageInput').value=current+1;document.getElementById('notePage').textContent=current+1;loadNote()});document.getElementById('totalPages').textContent=total}document.getElementById('totalPages').textContent=document.getElementById('totalPages').textContent==='1'?pages.length:document.getElementById('totalPages').textContent;page(0);zoomUI();loading.classList.add('d-none')}catch(e){console.error(e);loading.innerHTML='<div class="text-danger">Không tải được sách. Hãy kiểm tra file PDF/link trong Admin.</div>';return}
document.getElementById('prevBtn').onclick=()=>page(current-1);document.getElementById('nextBtn').onclick=()=>page(current+1);document.getElementById('pageInput').onchange=e=>page(Number(e.target.value)-1);document.getElementById('zoomIn').onclick=()=>{zoom=Math.min(2.5,zoom+.1);zoomUI()};document.getElementById('zoomOut').onclick=()=>{zoom=Math.max(.5,zoom-.1);zoomUI()};document.getElementById('fitBtn').onclick=()=>{zoom=1;rotation=0;zoomUI();stage.scrollTo({top:0,left:0})};document.getElementById('rotateBtn').onclick=()=>{rotation=(rotation+90)%360;zoomUI()};document.getElementById('fullscreenBtn').onclick=async()=>{if(!document.fullscreenElement)await document.querySelector('.reader-shell').requestFullscreen?.();else await document.exitFullscreen?.()};document.getElementById('tocBtn').onclick=()=>document.getElementById('tocPanel').classList.toggle('d-none');document.getElementById('tocClose').onclick=()=>document.getElementById('tocPanel').classList.add('d-none');
document.getElementById('penBtn').onclick=()=>{ink=!ink;highlight=false;stage.classList.toggle('ink-mode',ink);stage.classList.remove('highlight-mode');document.getElementById('penBtn').classList.toggle('active',ink);document.getElementById('highlightBtn').classList.remove('active')};document.getElementById('highlightBtn').onclick=()=>{highlight=!highlight;ink=false;stage.classList.toggle('highlight-mode',highlight);stage.classList.remove('ink-mode');document.getElementById('highlightBtn').classList.toggle('active',highlight);document.getElementById('penBtn').classList.remove('active')};document.getElementById('clearInkBtn').onclick=()=>{const c=pages[current]?.querySelector('.ink-layer');c?.getContext('2d').clearRect(0,0,c.width,c.height)};
document.getElementById('bookmarkBtn').onclick=()=>{store.bookmark=current+1;localStorage.setItem(storeKey,JSON.stringify(store));document.getElementById('bookmarkStatus').textContent='Đã đánh dấu trang '+(current+1)};if(store.bookmark)document.getElementById('bookmarkStatus').textContent='Trang đã đánh dấu: '+store.bookmark;function loadNote(){document.getElementById('noteText').value=(store.notes||{})[current+1]||''}document.getElementById('noteBtn').onclick=()=>{document.getElementById('notePanel').classList.remove('d-none');loadNote()};document.getElementById('noteClose').onclick=()=>document.getElementById('notePanel').classList.add('d-none');document.getElementById('saveNote').onclick=()=>{store.notes=store.notes||{};store.notes[current+1]=document.getElementById('noteText').value;localStorage.setItem(storeKey,JSON.stringify(store));document.getElementById('notePanel').classList.add('d-none')};
})();
</script>
<% if(mode==='chapters'){ %><div id="pageSource" class="d-none"><% chapters.forEach((c,i)=>{ %><div class="storypage"><div class="storypage-inner"><h4>Chương <%=i+1%>: <%=c.title%></h4><%if(c.unlocked){%><%-c.content%><%}else{%><div class="text-center py-5"><i class="fa-solid fa-lock fa-2x"></i><p>Chương này cần mở khóa.</p><a href="/doc-sach-online/<%=book.slug%>" class="btn btn-primary btn-sm">Mua/mở khóa</a></div><%}%></div></div><%})%></div><% } %>
<%- include('partials/footer') %>
