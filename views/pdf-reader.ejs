<% var pageTitle=title %><%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-2"><h4 class=fw-bold><%=title%></h4><a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">← Quay lại</a></div>
<div id=loading class="text-center py-5">Đang tải tài liệu...</div><div id=book></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script><script src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.js"></script>
<script>
(async()=>{try{pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';const pdf=await pdfjsLib.getDocument(<%-JSON.stringify(fileUrl)%>).promise;const box=document.getElementById('book');box.style.maxWidth='1000px';box.style.margin='auto';const pages=[];for(let i=1;i<=pdf.numPages;i++){const p=await pdf.getPage(i),v=p.getViewport({scale:1.25}),c=document.createElement('canvas');c.width=v.width;c.height=v.height;await p.render({canvasContext:c.getContext('2d'),viewport:v}).promise;const d=document.createElement('div');d.style.background='#fff';d.style.overflow='hidden';d.appendChild(c);pages.push(d)}document.getElementById('loading').remove();const pf=new St.PageFlip(box,{width:700,height:990,size:'stretch',minWidth:300,maxWidth:900,minHeight:420,maxHeight:1300,showCover:true});pf.loadFromHTML(pages);box.addEventListener('click',e=>{if(e.clientX<innerWidth/2)pf.flipPrev();else pf.flipNext()})}catch(e){document.getElementById('loading').innerHTML='<span class=text-danger>Không mở được PDF. Hãy kiểm tra link chia sẻ.</span>'}})();
</script><%- include('partials/footer') %>