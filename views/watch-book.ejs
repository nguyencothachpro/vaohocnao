<% var pageTitle=book.title+' - '+(lesson?lesson.title:''); %><%- include('partials/header') %>
<% if(locked){ %><div class="card p-5 text-center"><i class="fa-solid fa-lock fa-3x text-muted mb-3"></i><h4>Bài này cần quyền của sách</h4><a class="btn btn-primary" href="/sach/<%=book.slug%>">Xem sách</a></div><% }else{ %><div class="row"><aside class="col-lg-3"><div class="card p-3"><h6 class="fw-bold"><%=book.title%></h6><%fullTree.forEach(ch=>{%><div class="small fw-bold mt-3"><%=ch.title%></div><%ch.lessons.forEach(l=>{%><a class="d-block small py-1 <%=l.id===lesson.id?'fw-bold text-primary':''%>" href="/hoc-sach/<%=l.id%>"><%=l.title%></a><%})%><%})%></div></aside><main class="col-lg-9"><h3 class="fw-bold"><%=lesson.title%></h3><%videos.forEach(v=>{%><div class="ratio ratio-16x9 bg-dark rounded mb-3"><%if(v.source_type==='youtube'){%><iframe src="https://www.youtube-nocookie.com/embed/<%=v.source_value%>" allowfullscreen></iframe><%}else if(v.source_type==='drive'){%><iframe src="<%=v.source_value.replace('/view','/preview')%>" allowfullscreen></iframe><%}else{%><video controls class="w-100"><source src="<%=v.source_value%>"></video><%}%></div><%})%><%files.forEach(f=>{%><div class="card p-3 mb-2"><strong>📄 <%=f.title%></strong><a href="<%=f.file_url%>" target="_blank">Mở tài liệu</a></div><%})%></main></div><%}%><%- include('partials/footer') %>
