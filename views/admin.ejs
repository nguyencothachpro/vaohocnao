<!doctype html><html><head><meta charset=utf-8><link rel=stylesheet href=/style.css></head><body><main><h1>Admin</h1><a href=/>Website</a><section class=card><h2>Tạo sản phẩm</h2><form method=post action=/admin/product><select name=type><option value=course>Khóa học</option><option value=book>Sách</option><option value=reading>Đọc sách - tài liệu</option></select><input name=title placeholder="Tên sản phẩm" required><input name=slug placeholder="Slug"><input name=cover_url placeholder="Link ảnh bìa"><input name=short_desc placeholder="Mô tả"><label><input type=checkbox name=is_free> Miễn phí</label><button>Tạo</button></form></section><div class=grid><%products.forEach(p=>{%><article><h3><%=p.title%></h3><p><%=p.type%></p></article><%})%></div></main></body></html>