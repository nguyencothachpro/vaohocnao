<% var pageTitle='Phòng học cùng thầy cô' %>
<%- include('partials/header') %>
<div class="card p-4 mb-4 border-0 shadow-sm"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3"><div><h3 class="fw-bold mb-1">Phòng học</h3><p class="text-muted mb-0">Mỗi lớp có mã phòng riêng và mỗi học viên có mã cá nhân riêng. Giáo viên kiểm soát quyền viết.</p></div><% if(currentUser && ['super_admin','admin','teacher'].includes(currentUser.role)){%><a href="/admin/phong-hoc" class="btn btn-primary">Quản lý lớp</a><%}%></div></div>
<div class="row g-3">
<% rooms.forEach(r=>{%><div class="col-md-6 col-xl-4"><div class="card p-3 h-100 border-0 shadow-sm"><span class="badge bg-success mb-2 align-self-start">Đang mở</span><h5 class="fw-bold"><%=r.title%></h5><div class="small text-muted mb-3">Giáo viên: <%=r.teacher_name||'—'%><br>Mã phòng: <code><%=r.room_code%></code><br>Học viên: <b><%=r.student_count||0%></b></div><a class="btn btn-primary w-100" href="/phong-hoc/<%=r.room_code%>">Vào lớp</a></div></div><%})%>
<% if(!rooms.length){%><div class="col-12"><div class="card p-5 text-center text-muted">Hiện chưa có lớp học trực tuyến nào đang mở.</div></div><%}%>
</div>
<%- include('partials/footer') %>