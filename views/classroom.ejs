<% var pageTitle=room.title %>
<%- include('partials/header') %>
<div class="classroom-app">
  <% if(!isTeacher && !member){ %><div class="classroom-access-overlay"><div class="classroom-access-card"><div class="fs-1">🎓</div><h3>Vào lớp <%=room.title%></h3><p>Mã phòng: <code><%=room.room_code%></code></p><form method="post" action="/phong-hoc/<%=room.room_code%>/vao"><input name="student_code" class="form-control form-control-lg text-center fw-bold" placeholder="Nhập mã học viên, ví dụ HS001" autocomplete="off" required><button class="btn btn-primary btn-lg w-100 mt-3">Vào lớp</button></form><div class="small text-muted mt-3">Mỗi học viên dùng mã riêng do giáo viên cấp.</div></div></div><% } %>
  <div class="classroom-topbar"><div class="d-flex align-items-center gap-2 min-w-0"><a href="/phong-hoc" class="btn btn-sm btn-outline-light">← Phòng</a><div class="min-w-0"><strong class="text-truncate d-block"><%= room.title %></strong><span class="small opacity-75">Mã phòng: <%= room.room_code %> · <%= isTeacher ? 'GIÁO VIÊN' : (member ? member.display_name : 'HỌC VIÊN') %></span></div></div><div class="d-flex gap-1 align-items-center flex-wrap"><button class="tool-btn" id="prev">←</button><button class="tool-btn" id="next">→</button><label class="page-box"><span>Trang</span><input id="pageNumber" type="number" min="1" value="1"><span>/ <b id="pageTotal">1</b></span></label><button class="tool-btn" id="zoomOut">−</button><span id="zoomLabel" class="zoom-label">100%</span><button class="tool-btn" id="zoomIn">+</button><button class="tool-btn" id="fit">Fit</button><button class="tool-btn" id="fullscreen">⛶</button></div></div>
  <div class="classroom-main">
    <aside class="classroom-tools">
      <div class="tool-group-title">BẢNG</div>
      <button class="side-tool" id="pointerTool"><span>🖱</span>Chuột</button><button class="side-tool active" id="pen"><span>✎</span>Bút</button><button class="side-tool" id="highlighter"><span>▰</span>Đánh dấu</button><button class="side-tool" id="eraser"><span>⌫</span>Tẩy</button><button class="side-tool" id="textTool"><span>T</span>Chữ</button><button class="side-tool" id="clear"><span>⌫</span>Xóa trang</button><button class="side-tool" id="noteTool"><span>📝</span>Note</button>
      <div id="penOptions" class="pen-options"><div class="option-title">Nét bút</div><div class="option-row"><button class="color-dot active" data-ink="#ef4444" style="background:#ef4444"></button><button class="color-dot" data-ink="#2563eb" style="background:#2563eb"></button><button class="color-dot" data-ink="#111827" style="background:#111827"></button><button class="color-dot" data-ink="#16a34a" style="background:#16a34a"></button></div><select id="penWidth" class="form-select form-select-sm"><option value="1.5">Mảnh · 1.5px</option><option value="3" selected>Vừa · 3px</option><option value="5">Đậm · 5px</option><option value="8">Rất đậm · 8px</option><option value="12">Siêu đậm · 12px</option></select><select id="highlighterWidth" class="form-select form-select-sm mt-1"><option value="12">Highlight mảnh</option><option value="20" selected>Highlight vừa</option><option value="30">Highlight đậm</option></select></div>
      <div class="tool-divider"></div><div class="tool-group-title">THIẾT BỊ</div><button class="side-tool" id="cam"><span>📷</span>Camera</button><button class="side-tool" id="screen"><span>🖥</span>Màn hình</button><button class="side-tool" id="green"><span>🟢</span>Xóa nền</button>
      <div class="tool-divider"></div><div class="tool-group-title">KHÁC</div><button class="side-tool" id="materialsTool"><span>📚</span>Tài liệu</button><button class="side-tool" id="chatTool"><span>💬</span>Chat</button>
    </aside>
    <section class="classroom-stage" id="classroomStage"><div class="stage-toolbar"><div class="small text-muted"><b>Bảng giảng</b><span id="materialTitle" class="ms-2"></span></div><div class="d-flex gap-2"><button class="mini-btn" id="openPdf">Mở PDF</button><button class="mini-btn" id="resetView">Đặt lại khung</button></div></div><div class="book-viewport" id="bookViewport"><div id="pages" class="book-pages"></div></div><div class="video-pip d-none" id="videoPip"><video id="localVideo" autoplay muted playsinline></video><canvas id="keyCanvas" hidden></canvas><div class="pip-label"><%= isTeacher ? 'Bạn' : 'Giáo viên' %></div></div><div class="remote-video-pip d-none" id="remotePip"><video id="remoteVideo" autoplay playsinline></video><div class="pip-label">Giáo viên</div></div><div id="emptyBoard" class="empty-board <%= room.pdf_url ? 'd-none' : '' %>"><i class="fa-solid fa-pen-ruler"></i><h5>Bắt đầu giảng bài</h5><p>Mở PDF, tạo sổ trắng hoặc dùng Bút/Chữ để giảng bài.</p></div></section>
    <aside class="classroom-right"><div class="right-tabs"><button class="right-tab active" data-panel="materials">📚 Tài liệu</button><button class="right-tab" data-panel="notes">📝 Note</button><button class="right-tab" data-panel="chat">💬 Chat</button></div>
      <div id="panel-materials" class="right-panel active"><div class="panel-heading">Tài liệu trong phòng</div><div class="small text-muted mb-2">PDF/ảnh có thể đưa lên bảng. Ngoài ra có thể tạo một <b>sổ trắng lật như sách</b> để ghi bài.</div><div class="blank-books-title">SỔ NOTE TRẮNG</div><div class="blank-book-grid"><button class="blank-book" data-blank-template="paper"><span class="paper-preview paper"></span><b>Giấy trắng</b><small>Trang trắng</small></button><button class="blank-book" data-blank-template="lined"><span class="paper-preview lined"></span><b>Kẻ ngang</b><small>Ghi bài</small></button><button class="blank-book" data-blank-template="grid"><span class="paper-preview grid"></span><b>Ô ly</b><small>Toán học</small></button><button class="blank-book" data-blank-template="dot"><span class="paper-preview dot"></span><b>Chấm bi</b><small>Sơ đồ</small></button><button class="blank-book" data-blank-template="cornell"><span class="paper-preview cornell"></span><b>Cornell</b><small>Ghi chú</small></button><button class="blank-book" data-blank-template="math"><span class="paper-preview math"></span><b>Toán</b><small>Ô vuông nhỏ</small></button></div><button id="newBlankPage" class="btn btn-outline-primary btn-sm w-100 mt-2">＋ Thêm trang cùng mẫu</button>
        <%if(room.pdf_url){%><div class="blank-books-title mt-3">TÀI LIỆU ĐÃ CÓ</div><button class="material-card w-100 text-start" data-open-pdf="/phong-hoc/<%=room.room_code%>/pdf"><b>📕 PDF bài giảng</b><span>File mở sẵn</span></button><%}%><%materials.forEach(m=>{%><button class="material-card w-100 text-start" data-material-url="<%=m.url||''%>" data-material-kind="<%=m.kind%>"><b>📎 <%=m.title%></b><span><%=m.kind||'link'%> · Bấm để mở</span></button><%})%><%if(isTeacher){%><hr><div class="small fw-bold mb-2">Thêm tài liệu vào phòng</div><form method="post" action="/admin/phong-hoc/tai-lieu"><input type="hidden" name="classroom_id" value="<%=room.id%>"><input type="hidden" name="room_code" value="<%=room.room_code%>"><input name="title" class="form-control form-control-sm mb-2" placeholder="Tên tài liệu" required><input name="url" class="form-control form-control-sm mb-2" placeholder="Link PDF / Drive / ảnh / YouTube" required><select name="kind" class="form-select form-select-sm mb-2"><option value="pdf">PDF</option><option value="image">Ảnh</option><option value="video">Video</option><option value="link">Link</option></select><button class="btn btn-primary btn-sm w-100">＋ Thêm tài liệu</button></form><%}%></div>
      <div id="panel-notes" class="right-panel"><div class="panel-heading">Sổ ghi chú cá nhân</div><div class="small text-muted mb-2">Chọn mẫu giấy, màu nền và cỡ chữ. Nội dung tự lưu trên thiết bị.</div><div class="note-template-grid"><button class="note-template active" data-note-template="paper">📄<span>Giấy</span></button><button class="note-template" data-note-template="lined">☰<span>Kẻ dòng</span></button><button class="note-template" data-note-template="grid">▦<span>Ô ly</span></button><button class="note-template" data-note-template="dot">⠿<span>Chấm bi</span></button><button class="note-template" data-note-template="cornell">▥<span>Cornell</span></button><button class="note-template" data-note-template="dark">🌙<span>Tối</span></button></div><div class="note-toolbar"><select id="noteFontSize" class="form-select form-select-sm"><option value="14">Chữ 14</option><option value="16" selected>Chữ 16</option><option value="18">Chữ 18</option><option value="20">Chữ 20</option></select><button id="clearNotes" class="btn btn-outline-danger btn-sm">Xóa note</button></div><textarea id="notesArea" class="notes-area note-paper-paper" placeholder="Ghi công thức, ý chính, bài tập..."></textarea><div class="small text-success mt-2" id="notesSaved">✓ Tự lưu trên thiết bị</div></div>
      <div id="panel-chat" class="right-panel"><div class="panel-heading">Chat phòng học</div><div id="chatMessages" class="chat-messages"></div><form id="chatForm" class="d-flex gap-2 mt-2"><input id="chatInput" class="form-control form-control-sm" placeholder="Nhắn trong phòng..."><button class="btn btn-primary btn-sm">Gửi</button></form></div><div class="room-status mt-auto"><span class="status-dot"></span><span id="presenceText">Đang kết nối phòng học...</span></div>
    </aside>
  </div>
</div>
<style>
.classroom-app{height:calc(100vh - 112px);min-height:680px;background:#0f172a;border-radius:16px;overflow:hidden;box-shadow:0 18px 50px rgba(15,23,42,.18);position:relative}.classroom-topbar{height:58px;background:#111827;color:#fff;display:flex;justify-content:space-between;align-items:center;padding:8px 12px;gap:10px}.tool-btn{border:1px solid #334155;background:#1e293b;color:#fff;border-radius:8px;padding:6px 10px}.zoom-label{min-width:48px;text-align:center;font-size:12px}.page-box{display:flex;align-items:center;gap:4px;font-size:11px;background:#1e293b;padding:5px 7px;border-radius:8px}.page-box input{width:44px;background:#0f172a;border:1px solid #475569;color:#fff;border-radius:5px;text-align:center}.classroom-main{display:grid;grid-template-columns:84px minmax(0,1fr) 320px;height:calc(100% - 58px)}.classroom-tools{background:#111827;border-right:1px solid #243047;padding:9px 6px;display:flex;flex-direction:column;gap:4px;overflow:auto}.tool-group-title{font-size:9px;color:#94a3b8;text-align:center;margin:3px 0}.side-tool{border:0;background:transparent;color:#cbd5e1;border-radius:9px;padding:7px 3px;text-decoration:none;text-align:center;font-size:10px;cursor:pointer}.side-tool span{display:block;font-size:18px;margin-bottom:2px}.side-tool:hover,.side-tool.active{background:#263449;color:#fff}.tool-divider{height:1px;background:#263449;margin:6px 3px}.pen-options{background:#0b1220;border:1px solid #263449;border-radius:9px;padding:7px}.option-title{font-size:9px;color:#94a3b8;margin-bottom:5px}.option-row{display:flex;justify-content:center;gap:5px;margin-bottom:5px}.color-dot{width:17px;height:17px;border-radius:50%;border:2px solid #fff;padding:0;box-shadow:0 0 0 1px #475569;cursor:pointer}.color-dot.active{box-shadow:0 0 0 2px #60a5fa}.pen-options select{font-size:9px;padding:4px 3px}.classroom-stage{position:relative;min-width:0;background:#e5e7eb;overflow:hidden}.stage-toolbar{height:42px;background:#f8fafc;border-bottom:1px solid #dbe2ea;display:flex;justify-content:space-between;align-items:center;padding:0 12px}.mini-btn{border:1px solid #cbd5e1;background:#fff;border-radius:7px;padding:4px 8px;font-size:12px}.book-viewport{height:calc(100% - 42px);overflow:auto;display:flex;align-items:flex-start;justify-content:center;padding:24px;background:radial-gradient(circle at center,#f8fafc,#d8dee8);touch-action:pan-x pan-y}.book-pages{position:relative;width:min(900px,94%);min-height:480px;transform-origin:center top}.page-host{position:relative;background:#fff;box-shadow:0 12px 35px rgba(0,0,0,.18);overflow:hidden;aspect-ratio:.707/1}.page-host>canvas:first-child{display:block;width:100%;height:100%}.draw-layer{position:absolute;inset:0;width:100%;height:100%;touch-action:none}.pointer-mode .draw-layer{pointer-events:none}.blank-page{position:absolute;inset:0;background:#fff}.blank-page.paper{background:#fff}.blank-page.lined{background:repeating-linear-gradient(to bottom,#fff 0,#fff 31px,#dbeafe 32px)}.blank-page.grid{background-image:linear-gradient(#dbeafe 1px,transparent 1px),linear-gradient(90deg,#dbeafe 1px,transparent 1px);background-size:22px 22px}.blank-page.dot{background-image:radial-gradient(#94a3b8 .8px,transparent .9px);background-size:16px 16px}.blank-page.cornell{background:linear-gradient(90deg,transparent 0,transparent 27%,#cbd5e1 27.1%,#cbd5e1 27.4%,transparent 27.5%),#fff}.blank-page.math{background-image:linear-gradient(#bfdbfe 1px,transparent 1px),linear-gradient(90deg,#bfdbfe 1px,transparent 1px);background-size:12px 12px}.empty-board{position:absolute;inset:42px 0 0;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#64748b;text-align:center;pointer-events:none}.classroom-right{background:#fff;border-left:1px solid #dbe2ea;display:flex;flex-direction:column;min-width:0}.right-tabs{display:flex;border-bottom:1px solid #e2e8f0}.right-tab{flex:1;border:0;background:#fff;padding:12px 5px;font-size:12px}.right-tab.active{color:#2563eb;font-weight:700;border-bottom:2px solid #2563eb}.right-panel{display:none;padding:12px;overflow:auto}.right-panel.active{display:block}.panel-heading{font-weight:700;font-size:13px;margin-bottom:5px}.blank-books-title{font-size:9px;font-weight:800;color:#64748b;letter-spacing:.08em;margin:10px 0 7px}.blank-book-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.blank-book{border:1px solid #dbe2ea;background:#f8fafc;border-radius:9px;padding:6px;text-align:left;cursor:pointer}.blank-book:hover{border-color:#60a5fa;background:#eff6ff}.blank-book b,.blank-book small{display:block}.blank-book b{font-size:10px}.blank-book small{font-size:9px;color:#64748b}.paper-preview{display:block;height:70px;border-radius:5px;border:1px solid #cbd5e1;margin-bottom:5px;background:#fff}.paper-preview.lined{background:repeating-linear-gradient(to bottom,#fff 0,#fff 8px,#bfdbfe 9px)}.paper-preview.grid{background-image:linear-gradient(#bfdbfe 1px,transparent 1px),linear-gradient(90deg,#bfdbfe 1px,transparent 1px);background-size:8px 8px}.paper-preview.dot{background-image:radial-gradient(#64748b .7px,transparent .8px);background-size:7px 7px}.paper-preview.cornell{background:linear-gradient(90deg,transparent 0,transparent 28%,#cbd5e1 29%,transparent 30%)}.paper-preview.math{background-image:linear-gradient(#93c5fd 1px,transparent 1px),linear-gradient(90deg,#93c5fd 1px,transparent 1px);background-size:5px 5px}.material-card{display:block;border:1px solid #e2e8f0;background:#f8fafc;border-radius:9px;padding:10px;margin-bottom:7px;cursor:pointer}.material-card span{display:block;color:#64748b;font-size:10px;margin-top:3px}.note-template-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:8px}.note-template{border:1px solid #dbe2ea;background:#fff;border-radius:8px;padding:8px 4px;font-size:17px;cursor:pointer}.note-template span{display:block;font-size:9px;color:#475569;margin-top:2px}.note-template.active{border-color:#60a5fa;background:#eff6ff;color:#2563eb}.note-toolbar{display:grid;grid-template-columns:1fr auto;gap:6px;margin-bottom:7px}.notes-area{width:100%;min-height:390px;border:1px solid #cbd5e1;border-radius:9px;padding:14px;resize:vertical;font-family:Arial,sans-serif;line-height:1.8;outline:none}.note-paper-paper{background:#fff}.note-paper-lined{background:repeating-linear-gradient(to bottom,#fff 0,#fff 30px,#dbeafe 31px)}.note-paper-grid{background-image:linear-gradient(#dbeafe 1px,transparent 1px),linear-gradient(90deg,#dbeafe 1px,transparent 1px);background-size:22px 22px}.note-paper-dot{background-image:radial-gradient(#94a3b8 .8px,transparent .9px);background-size:16px 16px}.note-paper-cornell{background:linear-gradient(90deg,transparent 0,transparent 27%,#cbd5e1 27.1%,#cbd5e1 27.4%,transparent 27.5%),#fff}.note-paper-dark{background:#172033;color:#f8fafc;border-color:#334155}.chat-messages{height:420px;overflow:auto;background:#f8fafc;border:1px solid #e2e8f0;border-radius:9px;padding:8px}.chat-msg{background:#fff;border-radius:8px;padding:7px;margin-bottom:6px;font-size:12px}.chat-msg b{display:block}.room-status{border-top:1px solid #e2e8f0;padding:9px 12px;font-size:11px;color:#64748b}.status-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#22c55e;margin-right:6px}.video-pip,.remote-video-pip{position:absolute;right:18px;bottom:18px;width:240px;background:#000;border-radius:10px;overflow:hidden;z-index:30;box-shadow:0 12px 30px rgba(0,0,0,.3)}.video-pip video,.remote-video-pip video{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}.pip-label{position:absolute;left:7px;bottom:5px;background:rgba(0,0,0,.55);color:#fff;border-radius:5px;padding:2px 5px;font-size:10px}.classroom-access-overlay{position:absolute;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;background:rgba(15,23,42,.82);backdrop-filter:blur(5px)}.classroom-access-card{width:min(420px,calc(100% - 30px));background:#fff;border-radius:18px;padding:30px;box-shadow:0 24px 70px rgba(0,0,0,.35);text-align:center}
@media(max-width:1000px){.classroom-app{height:calc(100dvh - 76px);min-height:0;border-radius:0}.classroom-main{grid-template-columns:58px minmax(0,1fr);height:calc(100% - 52px)}.classroom-right{display:none}.classroom-topbar{height:52px;padding:6px 8px}.classroom-topbar .tool-btn{padding:5px 7px}.classroom-topbar .page-box{display:none}.classroom-tools{padding:6px 4px}.side-tool{padding:7px 2px}.book-viewport{padding:8px}.book-pages{width:96%;min-height:0}.stage-toolbar{height:38px;padding:0 7px}.video-pip,.remote-video-pip{width:150px;right:8px;bottom:8px}.pen-options{padding:5px}.blank-book-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.classroom-topbar>div:last-child{gap:2px!important}.classroom-topbar>div:last-child #zoomLabel,.classroom-topbar>div:last-child #fit{display:none}.classroom-topbar .tool-btn{font-size:12px;padding:5px 6px}.classroom-tools{grid-column:1}.classroom-stage{grid-column:2}.classroom-app{width:100vw}.book-pages{width:100%}.book-viewport{padding:4px}.notes-area{min-height:260px}}
</style>
<script src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.js"></script><script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script><script src="/socket.io/socket.io.js"></script>
<script>window.CLASSROOM=<%-JSON.stringify({room:room.room_code,isTeacher,memberId:member?.id||null,canWrite:member?.can_write||false,askTeacherEnabled:settings?.ask_teacher_enabled!==false,currentUser:member?.display_name||null})%>;</script><script src="/js/classroom.js"></script>
<%- include('partials/footer') %>