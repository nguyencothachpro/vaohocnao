<!doctype html><html><head><meta charset=utf-8><link rel=stylesheet href=/style.css></head><body><main><h1>Phòng học cùng thầy cô</h1><div class=classroom><aside><button onclick="mode='pen'">✎ Bút</button><button onclick="mode='erase'">Tẩy</button><button onclick="navigator.mediaDevices.getUserMedia({video:true,audio:true}).then(s=>v.srcObject=s)">📷 Camera + Mic</button><button onclick="navigator.mediaDevices.getDisplayMedia({video:true})">🖥 Chia sẻ màn hình</button></aside><section><canvas id=c></canvas><video id=v autoplay muted></video></section></div></main><script>let c=document.getElementById('c'),x=c.getContext('2d'),v=document.getElementById('v'),mode='pen';function z(){c.width=c.clientWidth*devicePixelRatio;c.height=650*devicePixelRatio;x.scale(devicePixelRatio,devicePixelRatio)}z();addEventListener('resize',z);let d=0;c.onpointerdown=e=>{d=1;x.beginPath();x.moveTo(e.offsetX,e.offsetY)};c.onpointerup=()=>d=0;c.onpointermove=e=>{if(!d)return;if(mode==='erase')x.clearRect(e.offsetX-10,e.offsetY-10,20,20);else{x.lineWidth=3;x.lineTo(e.offsetX,e.offsetY);x.stroke()}};</script></body></html>