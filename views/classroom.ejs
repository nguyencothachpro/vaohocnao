<% var pageTitle=room.title %>
<%- include('partials/header') %>
<div class="classroom-app" id="classroomApp">
  <header class="classroom-topbar">
    <div class="room-title-wrap"><a href="/phong-hoc" class="btn btn-sm btn-outline-light">← <span class="back-label">Phòng</span></a><div class="room-heading"><strong><%= room.title %></strong><div class="small opacity-75">Mã phòng: <%= room.room_code %> · <%= isTeacher ? 'GIÁO VIÊN' : 'HỌC VIÊN' %> · <span id="presenceText">Đang kết nối...</span></div></div></div>
    <div class="top-controls"><button class="tool-btn" id="prev" aria-label="Trang trước">←</button><button class="tool-btn" id="next" aria-label="Trang sau">→</button><label class="page-box">Trang <input id="pageNumber" type="number" min="1" value="1"><span>/ <b id="pageTotal">1</b></span></label><button class="tool-btn desktop-only" id="zoomOut">−</button><span id="zoomLabel" class="desktop-only">100%</span><button class="tool-btn desktop-only" id="zoomIn">+</button><button class="tool-btn desktop-only" id="fit">Fit</button><button class="tool-btn" id="fullscreen" aria-label="Toàn màn hình">⛶</button></div>
  </header>
  <div class="classroom-main">
    <aside class="classroom-tools desktop-tools"><div class="tool-section"><div class="tool-title">BẢNG</div><button class="side-tool active" id="pen"><span>✎</span>Bút</button><button class="side-tool" id="highlighter"><span>▰</span>Đánh dấu</button><button class="side-tool" id="eraser"><span>⌫</span>Tẩy</button><button class="side-tool" id="textTool"><span>T</span>Chữ</button><button class="side-tool" id="clear"><span>⌫</span>Xóa</button><button class="side-tool" id="noteTool"><span>📝</span>Note</button></div><div class="tool-section"><div class="tool-title">THIẾT BỊ</div><button class="side-tool" id="cam"><span>📷</span>Camera</button><button class="side-tool" id="screen"><span>🖥</span>Chia sẻ màn hình</button><button class="side-tool" id="green"><span>🟢</span>Xóa nền</button></div><div class="tool-section"><div class="tool-title">PHÒNG</div><button class="side-tool" id="openMaterials"><span>📚</span>Tài liệu</button><button class="side-tool" id="openNotes"><span>🗒</span>Ghi chú</button><button class="side-tool" id="openChat"><span>💬</span>Chat <span id="toolChatBadge" class="mini-badge d-none">0</span></button></div></aside>
    <main class="classroom-stage" id="classroomStage"><div class="stage-toolbar"><div class="stage-label">Bảng giảng <span class="touch-hint">Vuốt trái/phải để chuyển trang</span></div><div class="stage-actions"><button class="mini-btn" id="openPdf">Mở PDF</button><button class="mini-btn" id="resetView">Đặt lại</button></div></div><div class="book-viewport" id="bookViewport"><div class="page-nav-zone page-nav-left" id="tapPrev"></div><div id="pages" class="book-pages"></div><div class="page-nav-zone page-nav-right" id="tapNext"></div></div><div class="empty-board <%= room.pdf_url ? 'd-none' : '' %>" id="emptyBoard"><div class="empty-icon">✎</div><h5>Sẵn sàng giảng bài</h5><p>Mở PDF/tài liệu hoặc dùng Bút, Chữ, Note để bắt đầu.</p></div><div id="videoPip" class="video-pip d-none"><video id="localVideo" autoplay muted playsinline></video><div class="pip-label"><%= isTeacher ? 'Bạn' : 'Camera của bạn' %></div></div><div id="remotePip" class="video-pip remote d-none"><video id="remoteVideo" autoplay playsinline></video><div class="pip-label">Giáo viên</div></div></main>
    <aside class="classroom-right" id="classroomRight"><div class="right-tabs"><button class="right-tab active" data-panel="materials">📚 <span>Tài liệu</span></button><button class="right-tab" data-panel="notes">📝 <span>Note</span></button><button class="right-tab" data-panel="chat">💬 <span>Chat</span> <span id="chatBadge" class="badge bg-danger d-none">0</span></button></div>
      <section id="panel-materials" class="right-panel active"><div class="panel-help">Tài liệu trong phòng. Giáo viên mở tài liệu nào thì học viên có thể theo dõi tài liệu đó.</div><% if(room.pdf_url){ %><button class="material-card" data-open-pdf="/phong-hoc/<%=room.room_code%>/pdf"><b>📕 PDF bài giảng</b><span>Mở trong bảng</span></button><% } %><% materials.forEach(m=>{ %><button class="material-card" data-material-url="<%=m.url||''%>" data-material-kind="<%=m.kind%>"><b>📎 <%=m.title%></b><span><%=m.kind||'link'%> · Mở</span></button><% }) %><% if(isTeacher){ %><hr><div class="small fw-bold mb-2">Thêm tài liệu vào phòng</div><form method="post" action="/admin/phong-hoc/tai-lieu"><input type="hidden" name="classroom_id" value="<%=room.id%>"><input type="hidden" name="room_code" value="<%=room.room_code%>"><input name="title" class="form-control form-control-sm mb-2" placeholder="Tên tài liệu" required><input name="url" class="form-control form-control-sm mb-2" placeholder="Link PDF / Drive / ảnh / YouTube" required><select name="kind" class="form-select form-select-sm mb-2"><option value="pdf">PDF</option><option value="image">Ảnh</option><option value="video">Video</option><option value="link">Link</option></select><button class="btn btn-primary btn-sm w-100">+ Thêm tài liệu</button></form><div id="writerManager" class="mt-3"></div><div id="questionModeManager" class="mt-3"></div><% } %></section>
      <section id="panel-notes" class="right-panel notes-panel"><div class="notes-head"><div><div class="notes-title">Ghi chú của tôi</div><div class="panel-help mb-0">Tạo nhiều tài liệu ghi chú riêng cho từng phòng.</div></div><button class="btn btn-primary btn-sm" id="newNote">＋ Mới</button></div><div class="note-layout"><div id="noteList" class="note-list"></div><div class="note-editor"><div class="note-editor-toolbar"><select id="noteTemplate" class="form-select form-select-sm" title="Mẫu ghi chú"><option value="plain">Trống</option><option value="lined">Kẻ dòng</option><option value="grid">Ô vuông</option><option value="cornell">Cornell</option><option value="checklist">Checklist</option><option value="pastel">Pastel</option></select><input id="noteTitle" class="form-control form-control-sm" placeholder="Tên tài liệu"><button id="deleteNote" class="btn btn-outline-danger btn-sm">Xóa</button></div><textarea id="notesArea" class="notes-area" placeholder="Viết nội dung ghi chú..."></textarea><div class="small text-success mt-2" id="notesSaved">Tự lưu trên thiết bị</div></div></div></section>
      <section id="panel-chat" class="right-panel"><div id="chatMessages" class="chat-messages"></div><form id="chatForm" class="chat-form"><input id="chatInput" class="form-control form-control-sm" placeholder="Nhắn trong phòng..."><button class="btn btn-primary btn-sm">Gửi</button></form><div id="questionBox" class="question-box d-none"><div class="small fw-bold mb-1">❓ Hỏi giáo viên</div><form id="questionForm" class="d-flex gap-2"><input id="questionInput" class="form-control form-control-sm" placeholder="Đặt câu hỏi..."><button class="btn btn-warning btn-sm">Gửi</button></form></div></section>
    </aside>
  </div>
  <nav class="mobile-dock" id="mobileDock"><button data-action="tools">✎<span>Bảng</span></button><button data-action="materials">📚<span>Tài liệu</span></button><button data-action="notes">📝<span>Ghi chú</span></button><button data-action="chat">💬<span>Chat</span><i id="dockChatBadge" class="d-none">0</i></button></nav>
</div>
<style>
:root{--classroom-bg:#dfe4ea;--classroom-dark:#0f172a;--classroom-blue:#2563eb}.classroom-app{height:calc(100vh - 92px);min-height:600px;background:var(--classroom-dark);border-radius:14px;overflow:hidden;box-shadow:0 20px 60px rgba(15,23,42,.2);position:relative}.classroom-topbar{height:58px;background:#111827;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:7px 12px;position:relative;z-index:70}.room-title-wrap,.top-controls{display:flex;align-items:center;gap:8px}.room-heading{min-width:0}.room-heading strong{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:34vw}.top-controls{flex-wrap:wrap}.tool-btn,.mini-btn{border:1px solid #334155;background:#1e293b;color:#fff;border-radius:8px;padding:6px 10px;min-height:36px}.page-box{display:flex;align-items:center;gap:4px;background:#1e293b;padding:6px 8px;border-radius:8px;font-size:12px}.page-box input{width:48px;background:#0f172a;color:#fff;border:1px solid #475569;border-radius:5px;text-align:center}.classroom-main{display:grid;grid-template-columns:78px minmax(0,1fr) 340px;height:calc(100% - 58px)}.classroom-tools{background:#0b1220;color:#cbd5e1;border-right:1px solid #263246;padding:10px 7px;overflow:auto}.tool-section{margin-bottom:12px}.tool-title{font-size:9px;color:#64748b;text-align:center;margin-bottom:6px;letter-spacing:.08em}.side-tool{width:100%;border:0;background:transparent;color:#cbd5e1;border-radius:9px;padding:8px 4px;margin-bottom:3px;text-align:center;font-size:10px}.side-tool span:first-child{display:block;font-size:19px;line-height:1.1;margin-bottom:3px}.side-tool.active,.side-tool:hover{background:#1e293b;color:#fff}.side-tool:disabled{opacity:.28;cursor:not-allowed}.classroom-stage{position:relative;min-width:0;background:var(--classroom-bg);overflow:hidden}.stage-toolbar{height:44px;background:#f8fafc;border-bottom:1px solid #d8dee7;display:flex;align-items:center;justify-content:space-between;padding:0 14px;position:relative;z-index:12}.stage-label{font-size:12px;color:#475569;font-weight:600}.touch-hint{font-weight:400;color:#94a3b8;margin-left:8px}.stage-actions{display:flex;gap:8px}.mini-btn{color:#0f172a;background:#fff;border-color:#cbd5e1;font-size:12px;min-height:30px}.book-viewport{position:absolute;inset:44px 0 0;overflow:auto;display:flex;justify-content:center;align-items:flex-start;padding:18px;background:linear-gradient(180deg,#eef2f7,#d8dde5);overscroll-behavior:contain;touch-action:pan-y}.book-pages{width:min(1080px,96%);min-height:520px;transform-origin:center top;transition:transform .18s ease}.page-host{position:relative;width:100%;aspect-ratio:.707/1;background:#fff;box-shadow:0 16px 40px rgba(15,23,42,.2);overflow:hidden;margin:0 auto}.draw-layer{position:absolute;inset:0;width:100%;height:100%;touch-action:none}.page-nav-zone{display:none}.empty-board{position:absolute;inset:44px 0 0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#64748b;text-align:center;pointer-events:none}.empty-icon{font-size:44px}.pdf-error{min-height:360px;width:min(520px,92%);margin:auto;background:#fff;border-radius:16px;padding:30px;text-align:center;box-shadow:0 10px 30px rgba(15,23,42,.12);color:#475569}.pdf-error-icon{font-size:40px}.classroom-right{background:#fff;border-left:1px solid #dbe2ea;display:flex;flex-direction:column;min-width:0}.right-tabs{display:flex;border-bottom:1px solid #e2e8f0;flex:none}.right-tab{flex:1;border:0;background:#fff;padding:12px 5px;font-size:12px;min-height:45px}.right-tab.active{color:#2563eb;font-weight:700;border-bottom:2px solid #2563eb}.right-panel{display:none;padding:12px;overflow:auto;min-height:0}.right-panel.active{display:block}.panel-help{font-size:12px;color:#64748b;margin-bottom:10px;line-height:1.45}.material-card{width:100%;display:flex;flex-direction:column;align-items:flex-start;gap:3px;border:1px solid #e2e8f0;background:#f8fafc;border-radius:10px;padding:10px 11px;margin-bottom:8px;text-align:left}.material-card span{font-size:11px;color:#64748b}.notes-panel{padding:10px}.notes-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px}.notes-title{font-weight:700}.note-layout{display:grid;grid-template-columns:115px minmax(0,1fr);gap:8px;min-height:540px}.note-list{border:1px solid #e2e8f0;border-radius:10px;background:#f8fafc;padding:6px;overflow:auto}.note-item{border:1px solid transparent;background:#fff;border-radius:8px;padding:8px;margin-bottom:5px;font-size:11px;cursor:pointer}.note-item.active{border-color:#93c5fd;background:#eff6ff}.note-item small{display:block;color:#94a3b8;margin-top:2px}.note-editor{min-width:0;display:flex;flex-direction:column}.note-editor-toolbar{display:grid;grid-template-columns:105px minmax(0,1fr) auto;gap:6px;margin-bottom:6px}.notes-area{width:100%;flex:1;min-height:480px;border:1px solid #cbd5e1;border-radius:10px;padding:14px;resize:none;font-size:15px;line-height:1.75;background-color:#fff;background-size:auto}.notes-area.template-lined{background-image:linear-gradient(to bottom,transparent 31px,#dbeafe 32px);background-size:100% 32px}.notes-area.template-grid{background-image:linear-gradient(#e2e8f0 1px,transparent 1px),linear-gradient(90deg,#e2e8f0 1px,transparent 1px);background-size:24px 24px}.notes-area.template-cornell{background-image:linear-gradient(90deg,transparent 28%,#fecaca 28%,#fecaca calc(28% + 1px),transparent calc(28% + 1px)),linear-gradient(to bottom,transparent 31px,#dbeafe 32px);background-size:100% 32px}.notes-area.template-checklist{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.notes-area.template-pastel{background:linear-gradient(135deg,#fff7ed,#eff6ff 55%,#fdf2f8)}.chat-messages{height:calc(100vh - 260px);min-height:300px;overflow:auto;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:8px}.chat-msg{background:#fff;border:1px solid #edf2f7;border-radius:9px;padding:8px;margin-bottom:6px;font-size:12px}.chat-msg b{display:block}.chat-form{display:flex;gap:7px;margin-top:8px}.question-box{margin-top:10px;padding:10px;background:#fff8e6;border:1px solid #fde68a;border-radius:10px}.write-permission-bar{position:absolute;left:14px;right:14px;bottom:14px;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 11px;border-radius:10px;background:rgba(15,23,42,.92);color:#fff;font-size:12px}.write-permission-bar.teacher{left:auto;right:14px;max-width:450px}.writer-member{display:flex;align-items:center;justify-content:space-between;gap:8px;border:1px solid #e2e8f0;border-radius:8px;padding:8px;margin-bottom:6px;background:#fff}.qmode-card{border:1px solid #e2e8f0;border-radius:8px;padding:9px;background:#f8fafc}.mini-badge{font-size:9px;background:#ef4444;border-radius:10px;padding:2px 5px}.mobile-dock{display:none}
@media(max-width:1100px){.classroom-main{grid-template-columns:64px minmax(0,1fr)}.classroom-right{position:absolute;right:0;top:58px;bottom:0;width:min(92vw,380px);z-index:60;transform:translateX(100%);transition:transform .22s ease;box-shadow:-10px 0 30px rgba(15,23,42,.15)}.classroom-right.mobile-open{transform:translateX(0)}.classroom-app{height:calc(100vh - 72px);min-height:560px}.note-layout{min-height:0}}
@media(max-width:700px){body{overflow-x:hidden}.classroom-app{height:100dvh;min-height:0;border-radius:0;box-shadow:none;margin:0}.classroom-topbar{height:58px;padding:6px 7px;gap:5px}.back-label{display:none}.room-heading strong{max-width:30vw}.room-heading .small{font-size:9px;white-space:nowrap}.top-controls{gap:3px;flex-wrap:nowrap}.top-controls .tool-btn{padding:5px 8px;min-height:34px}.page-box{padding:5px;font-size:10px}.page-box input{width:38px}.desktop-tools{display:none}.classroom-main{display:block;height:calc(100% - 58px)}.classroom-stage{height:100%;width:100%}.stage-toolbar{height:40px;padding:0 8px}.stage-label{font-size:10px}.touch-hint{display:inline}.stage-actions{gap:4px}.mini-btn{font-size:10px;padding:4px 7px}.book-viewport{inset:40px 0 0;padding:4px 0 70px;align-items:flex-start;justify-content:center;background:#cfd5dd}.book-pages{width:100%;min-height:0}.page-host{width:100%;box-shadow:0 5px 16px rgba(15,23,42,.18);aspect-ratio:.707/1}.page-nav-zone{display:block;position:absolute;top:0;bottom:70px;width:18%;z-index:25}.page-nav-left{left:0}.page-nav-right{right:0}.empty-board{inset:40px 0 70px}.video-pip{right:8px;bottom:78px;width:34vw}.video-pip.remote{right:8px;bottom:calc(78px + 34vw*.5625 + 7px)}.classroom-right{top:58px;bottom:0;width:100%;transform:translateX(100%);padding-bottom:62px}.right-tabs{padding-top:2px}.right-tab{font-size:11px}.right-panel{padding:10px}.mobile-dock{position:absolute;display:flex;left:0;right:0;bottom:0;height:62px;background:rgba(15,23,42,.98);z-index:80;padding:5px 4px env(safe-area-inset-bottom)}.mobile-dock button{position:relative;flex:1;border:0;background:transparent;color:#cbd5e1;font-size:18px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px}.mobile-dock button.active{color:#fff}.mobile-dock button span{font-size:9px}.mobile-dock i{position:absolute;top:1px;right:18%;font-style:normal;background:#ef4444;color:#fff;border-radius:10px;font-size:9px;padding:1px 4px}.notes-panel{padding:8px}.note-layout{grid-template-columns:1fr;gap:7px}.note-list{display:flex;overflow-x:auto;min-height:48px;max-height:54px;padding:4px}.note-item{min-width:120px;margin:0 4px 0 0;padding:6px}.note-editor-toolbar{grid-template-columns:92px minmax(0,1fr) auto}.notes-area{min-height:55vh;font-size:14px}.chat-messages{height:calc(100dvh - 220px);min-height:240px}.touch-hint{font-size:9px}.desktop-only{display:none!important}}
@media(min-width:701px) and (max-width:1100px){.book-pages{width:min(900px,94%)}.classroom-right{width:min(88vw,400px)}}
</style>
<script src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.js"></script><script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script><script src="/socket.io/socket.io.js"></script>
<script>window.CLASSROOM=<%-JSON.stringify({room:room.room_code,isTeacher,currentUser:req?.session?.user?.name || req?.session?.adminUser?.name || (isTeacher?'Giáo viên':'Học viên'),currentUserId:req?.session?.user?.id || req?.session?.adminUser?.id || null,initialPdf:Boolean(room.pdf_url)})%>;</script>
<script src="/js/classroom-permissions.js"></script><script src="/js/classroom.js"></script>
<script>window.addClassroomChatMessage=function(user,text){const box=document.getElementById('chatMessages');if(!box)return;const d=document.createElement('div');d.className='chat-msg';d.innerHTML='<b></b><span></span>';d.querySelector('b').textContent=user;d.querySelector('span').textContent=text;box.appendChild(d);box.scrollTop=box.scrollHeight;const tab=document.querySelector('[data-panel="chat"]');if(tab&&!document.getElementById('panel-chat')?.classList.contains('active')){const b=document.getElementById('chatBadge');if(b){b.textContent=String((Number(b.textContent)||0)+1);b.classList.remove('d-none')}}};</script>
<%- include('partials/footer') %>