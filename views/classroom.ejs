<% var pageTitle=room.title; %><%- include('partials/header') %>
<style>
.classroom{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:14px}.stage{background:#111827;border-radius:14px;min-height:720px;overflow:hidden;position:relative}.board{position:absolute;inset:0;background:#fff}.toolbar{position:absolute;left:12px;top:12px;z-index:5;background:#fff;border-radius:12px;padding:7px;display:flex;gap:5px;flex-wrap:wrap;box-shadow:0 5px 18px #0002}.toolbar button{border:1px solid #ddd;background:#fff;border-radius:8px;padding:7px 9px}.side{display:flex;flex-direction:column;gap:12px}.panel{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:12px}.teacher-cam{width:100%;aspect-ratio:16/9;background:#111;object-fit:cover;border-radius:10px}.pdfbox{height:360px;background:#111827;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff}.room-code{font-family:monospace;font-weight:700}
</style>
<div class="d-flex justify-content-between align-items-center mb-3"><div><a href="/hoc-cung-thay-co">← Phòng học</a><h3 class="fw-bold d-inline ms-2"><%=room.title%></h3></div><span class="badge bg-light text-dark">Mã: <span class="room-code"><%=room.room_code%></span></span></div>
<div class="classroom"><div class="stage"><canvas id="board" class="board"></canvas><div class="toolbar"><button data-tool="pen">✎ Bút</button><button data-tool="highlight">🖍 Highlight</button><button data-tool="eraser">⌫ Tẩy</button><button id="textBtn">T Text</button><button id="clearBtn">Xóa</button><button id="undoBtn">↶</button><label class="btn btn-light border mb-0">Màu <input id="color" type="color" value="#111111"></label><label class="btn btn-light border mb-0">Cỡ <input id="size" type="range" min="1" max="20" value="4"></label><button id="cameraBtn">📷 Camera</button><button id="micBtn">🎙 Mic</button><button id="shareBtn">🖥 Chia sẻ màn hình</button><button id="pdfBtn">📖 Mở PDF</button><input id="pdfUrl" class="form-control" style="width:220px" placeholder="Link PDF/Drive"></div><video id="preview" class="position-absolute bottom-0 end-0 m-3 teacher-cam" style="width:240px;z-index:6;display:none" autoplay muted playsinline></video></div><div class="side"><div class="panel"><h6>Phòng học</h6><div class="small text-muted">Giáo viên: <%=teacher?'Bạn đang dạy':'Đang tham gia'%></div><div class="small mt-2">Realtime bảng viết: <span id="status">đang kết nối...</span></div></div><div class="panel"><h6>Tài liệu</h6><div id="pdfPanel" class="pdfbox">Dán link PDF rồi bấm “Mở PDF”</div></div><div class="panel"><h6>Camera/Micro</h6><div class="small text-muted">Camera và micro chạy trực tiếp trên trình duyệt. Chia sẻ màn hình có thể đưa OBS hoặc cửa sổ khác vào phòng.</div></div></div></div>
<script>
const isTeacher=<%=teacher?'true':'false'%>,room='<%=room.room_code%>'; const ws=new WebSocket((location.protocol==='https:'?'wss://':'ws://')+location.host+'/ws/classroom?room='+room+'&role='+(isTeacher?'teacher':'student')); const statusEl=document.getElementById('status'); ws.onopen=()=>statusEl.textContent='đã kết nối'; ws.onclose=()=>statusEl.textContent='mất kết nối';
const canvas=document.getElementById('board'),ctx=canvas.getContext('2d'); let drawing=false,tool='pen',last=null,history=[];
function resize(){const r=canvas.getBoundingClientRect();const old=document.createElement('canvas');old.width=canvas.width;old.height=canvas.height;if(canvas.width&&canvas.height)old.getContext('2d').drawImage(canvas,0,0);canvas.width=r.width*devicePixelRatio;canvas.height=r.height*devicePixelRatio;ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);if(old.width)ctx.drawImage(old,0,0,old.width/devicePixelRatio,old.height/devicePixelRatio);} addEventListener('resize',resize);resize();
function point(e){const r=canvas.getBoundingClientRect();return{x:e.clientX-r.left,y:e.clientY-r.top}}
canvas.addEventListener('pointerdown',e=>{drawing=true;last=point(e);history.push(canvas.toDataURL());}); canvas.addEventListener('pointerup',()=>{drawing=false;last=null}); canvas.addEventListener('pointermove',e=>{if(!drawing)return;const p=point(e);ctx.lineCap='round';ctx.lineJoin='round';ctx.strokeStyle=tool==='eraser'?'#fff':document.getElementById('color').value;ctx.globalAlpha=tool==='highlight'?.25:1;ctx.lineWidth=+document.getElementById('size').value*(tool==='highlight'?4:1);ctx.beginPath();ctx.moveTo(last.x,last.y);ctx.lineTo(p.x,p.y);ctx.stroke();last=p;});
document.querySelectorAll('[data-tool]').forEach(b=>b.onclick=()=>tool=b.dataset.tool);document.getElementById('clearBtn').onclick=()=>{history.push(canvas.toDataURL());ctx.clearRect(0,0,canvas.width,canvas.height);broadcast({type:'board',data:canvas.toDataURL()})};document.getElementById('undoBtn').onclick=()=>{const data=history.pop();if(!data)return;const img=new Image();img.onload=()=>{ctx.clearRect(0,0,canvas.width,canvas.height);ctx.drawImage(img,0,0,canvas.width/devicePixelRatio,canvas.height/devicePixelRatio)};img.src=data;};
function broadcast(m){if(ws.readyState===1)ws.send(JSON.stringify(m));}
setInterval(()=>{if(isTeacher)broadcast({type:'board',data:canvas.toDataURL('image/webp',.65)});},1200);
ws.onmessage=e=>{let m;try{m=JSON.parse(e.data)}catch{return}if(m.type==='board'&& !isTeacher){const img=new Image();img.onload=()=>{ctx.clearRect(0,0,canvas.width,canvas.height);ctx.drawImage(img,0,0,canvas.width/devicePixelRatio,canvas.height/devicePixelRatio)};img.src=m.data;}}
let stream=null;document.getElementById('cameraBtn').onclick=async()=>{if(!stream)stream=await navigator.mediaDevices.getUserMedia({video:true,audio:false});const v=document.getElementById('preview');v.srcObject=stream;v.style.display='block';};document.getElementById('micBtn').onclick=async()=>{if(!stream)stream=await navigator.mediaDevices.getUserMedia({video:false,audio:true});else{const a=await navigator.mediaDevices.getUserMedia({video:false,audio:true});a.getAudioTracks().forEach(t=>stream.addTrack(t));}alert('Micro đã bật trên máy giáo viên.');};document.getElementById('shareBtn').onclick=async()=>{const s=await navigator.mediaDevices.getDisplayMedia({video:true,audio:true});const v=document.getElementById('preview');v.srcObject=s;v.style.display='block';};
document.getElementById('pdfBtn').onclick=()=>{const u=document.getElementById('pdfUrl').value.trim();if(!u)return;document.getElementById('pdfPanel').innerHTML='<iframe src="'+u.replace('/view','/preview')+'" style="width:100%;height:100%;border:0"></iframe>';broadcast({type:'pdf',url:u});};ws.addEventListener('message',e=>{let m;try{m=JSON.parse(e.data)}catch{return}if(m.type==='pdf'&&!isTeacher)document.getElementById('pdfPanel').innerHTML='<iframe src="'+m.url.replace('/view','/preview')+'" style="width:100%;height:100%;border:0"></iframe>';});
</script><%- include('partials/footer') %>
