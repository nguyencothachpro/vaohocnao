<% var pageTitle=room.title %>
<%- include('partials/header') %>
<div class="classroom-app" id="classroomApp">
  <header class="classroom-topbar">
    <div class="room-title-wrap"><a href="/phong-hoc" class="btn btn-sm btn-outline-light">← Phòng</a><div><strong><%= room.title %></strong><div class="small opacity-75">Mã phòng: <%= room.room_code %> · <%= isTeacher ? 'GIÁO VIÊN' : 'HỌC VIÊN' %> · <span id="presenceText">Đang kết nối...</span></div></div></div>
    <div class="top-controls"><button class="tool-btn" id="prev">←</button><button class="tool-btn" id="next">→</button><label class="page-box">Trang <input id="pageNumber" type="number" min="1" value="1"><span>/ <b id="pageTotal">1</b></span></label><button class="tool-btn" id="zoomOut">−</button><span id="zoomLabel">100%</span><button class="tool-btn" id="zoomIn">+</button><button class="tool-btn" id="fit">Fit</button><button class="tool-btn" id="fullscreen">⛶</button></div>
  </header>
  <div class="classroom-main">
    <aside class="classroom-tools">
      <div class="tool-section"><div class="tool-title">BẢNG</div><button class="side-tool active" id="pen"><span>✎</span>Bút</button><button class="side-tool" id="highlighter"><span>▰</span>Đánh dấu</button><button class="side-tool" id="eraser"><span>⌫</span>Tẩy</button><button class="side-tool" id="textTool"><span>T</span>Chữ</button><button class="side-tool" id="clear"><span>⌫</span>Xóa</button><button class="side-tool" id="noteTool"><span>📝</span>Note</button></div>
      <div class="tool-section"><div class="tool-title">THIẾT BỊ</div><button class="side-tool" id="cam"><span>📷</span>Camera</button><button class="side-tool" id="screen"><span>🖥</span>Chia sẻ màn hình</button><button class="side-tool" id="green"><span>🟢</span>Xóa nền</button></div>
      <div class="tool-section"><div class="tool-title">PHÒNG</div><button class="side-tool" id="openMaterials"><span>📚</span>Tài liệu</button><button class="side-tool" id="openNotes"><span>🗒</span>Ghi chú</button><button class="side-tool" id="openChat"><span>💬</span>Chat</button></div>
    </aside>
    <main class="classroom-stage" id="classroomStage">
      <div class="stage-toolbar"><div class="stage-label">Bảng giảng</div><div class="stage-actions"><button class="mini-btn" id="openPdf">Mở PDF</button><button class="mini-btn" id="resetView">Đặt lại khung</button></div></div>
      <div class="book-viewport" id="bookViewport"><div id="pages" class="book-pages"></div></div>
      <div class="empty-board <%= room.pdf_url ? 'd-none' : '' %>" id="emptyBoard"><div class="empty-icon">✎</div><h5>Sẵn sàng giảng bài</h5><p>Mở PDF/tài liệu hoặc dùng Bút, Chữ, Note để bắt đầu.</p></div>
      <div id="videoPip" class="video-pip d-none"><video id="localVideo" autoplay muted playsinline></video><div class="pip-label"><%= isTeacher ? 'Bạn' : 'Camera của bạn' %></div></div>
      <div id="remotePip" class="video-pip remote d-none"><video id="remoteVideo" autoplay playsinline></video><div class="pip-label">Giáo viên</div></div>
    </main>
    <aside class="classroom-right" id="classroomRight">
      <div class="right-tabs"><button class="right-tab active" data-panel="materials">📚 Tài liệu</button><button class="right-tab" data-panel="notes">📝 Note</button><button class="right-tab" data-panel="chat">💬 Chat <span id="chatBadge" class="badge bg-danger d-none">0</span></button></div>
      <section id="panel-materials" class="right-panel active">
        <div class="panel-help">Tài liệu trong phòng. Chọn tài liệu để mở vào vùng giảng.</div>
        <% if(room.pdf_url){ %><button class="material-card" data-open-pdf="/phong-hoc/<%=room.room_code%>/pdf"><b>📕 PDF bài giảng</b><span>Mở trong bảng</span></button><% } %>
        <% materials.forEach(m=>{ %><button class="material-card" data-material-url="<%=m.url||''%>" data-material-kind="<%=m.kind%>"><b>📎 <%=m.title%></b><span><%=m.kind||'link'%> · Mở</span></button><% }) %>
        <% if(isTeacher){ %><hr><div class="small fw-bold mb-2">Thêm tài liệu vào phòng</div><form method="post" action="/admin/phong-hoc/tai-lieu"><input type="hidden" name="classroom_id" value="<%=room.id%>"><input type="hidden" name="room_code" value="<%=room.room_code%>"><input name="title" class="form-control form-control-sm mb-2" placeholder="Tên tài liệu" required><input name="url" class="form-control form-control-sm mb-2" placeholder="Link PDF / Drive / ảnh / YouTube" required><select name="kind" class="form-select form-select-sm mb-2"><option value="pdf">PDF</option><option value="image">Ảnh</option><option value="video">Video</option><option value="link">Link</option></select><button class="btn btn-primary btn-sm w-100">+ Thêm tài liệu</button></form><div id="writerManager" class="mt-3"></div><div id="questionModeManager" class="mt-3"></div><% } %>
      </section>
      <section id="panel-notes" class="right-panel"><div class="panel-help">Ghi chú cá nhân trên thiết bị của bạn.</div><textarea id="notesArea" class="notes-area" placeholder="Công thức, ý chính, bài tập..."></textarea><div class="small text-success mt-2" id="notesSaved">Tự lưu</div></section>
      <section id="panel-chat" class="right-panel"><div id="chatMessages" class="chat-messages"></div><form id="chatForm" class="chat-form"><input id="chatInput" class="form-control form-control-sm" placeholder="Nhắn trong phòng..."><button class="btn btn-primary btn-sm">Gửi</button></form><div id="questionBox" class="question-box d-none"><div class="small fw-bold mb-1">❓ Hỏi giáo viên</div><form id="questionForm" class="d-flex gap-2"><input id="questionInput" class="form-control form-control-sm" placeholder="Đặt câu hỏi..."><button class="btn btn-warning btn-sm">Gửi</button></form></div></section>
    </aside>
  </div>
</div>
<style>
.classroom-app{height:calc(100vh - 92px);min-height:720px;background:#0f172a;border-radius:14px;overflow:hidden;box-shadow:0 20px 60px rgba(15,23,42,.2)}.classroom-topbar{height:58px;background:#111827;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 12px}.room-title-wrap,.top-controls{display:flex;align-items:center;gap:10px}.top-controls{flex-wrap:wrap}.tool-btn,.mini-btn{border:1px solid #334155;background:#1e293b;color:#fff;border-radius:8px;padding:6px 10px}.page-box{display:flex;align-items:center;gap:4px;background:#1e293b;padding:6px 8px;border-radius:8px;font-size:12px}.page-box input{width:48px;background:#0f172a;color:#fff;border:1px solid #475569;border-radius:5px;text-align:center}.classroom-main{display:grid;grid-template-columns:82px minmax(0,1fr) 340px;height:calc(100% - 58px)}.classroom-tools{background:#0b1220;color:#cbd5e1;border-right:1px solid #263246;padding:10px 7px;overflow:auto}.tool-section{margin-bottom:12px}.tool-title{font-size:9px;color:#64748b;text-align:center;margin-bottom:6px;letter-spacing:.08em}.side-tool{width:100%;border:0;background:transparent;color:#cbd5e1;border-radius:9px;padding:8px 4px;margin-bottom:3px;text-align:center;font-size:10px}.side-tool span{display:block;font-size:19px;line-height:1.1;margin-bottom:3px}.side-tool.active,.side-tool:hover{background:#1e293b;color:#fff}.side-tool:disabled{opacity:.28;cursor:not-allowed}.classroom-stage{position:relative;min-width:0;background:#dfe4ea;overflow:hidden}.stage-toolbar{height:44px;background:#f8fafc;border-bottom:1px solid #d8dee7;display:flex;align-items:center;justify-content:space-between;padding:0 14px}.stage-label{font-size:12px;color:#475569;font-weight:600}.stage-actions{display:flex;gap:8px}.mini-btn{color:#0f172a;background:#fff;border-color:#cbd5e1;font-size:12px}.book-viewport{position:absolute;inset:44px 0 0;overflow:auto;display:flex;justify-content:center;align-items:flex-start;padding:26px;background:linear-gradient(180deg,#eef2f7,#d8dde5)}.book-pages{width:min(960px,92%);min-height:520px;transform-origin:center top}.page-host{position:relative;width:100%;aspect-ratio:.707/1;background:#fff;box-shadow:0 16px 40px rgba(15,23,42,.2);overflow:hidden;margin:0 auto}.draw-layer{position:absolute;inset:0;width:100%;height:100%;touch-action:none}.empty-board{position:absolute;inset:44px 0 0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#64748b;text-align:center;pointer-events:none}.empty-icon{font-size:44px}.classroom-right{background:#fff;border-left:1px solid #dbe2ea;display:flex;flex-direction:column;min-width:0}.right-tabs{display:flex;border-bottom:1px solid #e2e8f0}.right-tab{flex:1;border:0;background:#fff;padding:12px 5px;font-size:12px}.right-tab.active{color:#2563eb;font-weight:700;border-bottom:2px solid #2563eb}.right-panel{display:none;padding:12px;overflow:auto}.right-panel.active{display:block}.panel-help{font-size:12px;color:#64748b;margin-bottom:10px;line-height:1.45}.material-card{width:100%;display:flex;flex-direction:column;align-items:flex-start;gap:3px;border:1px solid #e2e8f0;background:#f8fafc;border-radius:10px;padding:10px 11px;margin-bottom:8px;text-align:left}.material-card span{font-size:11px;color:#64748b}.notes-area{width:100%;min-height:470px;border:1px solid #cbd5e1;border-radius:10px;padding:10px;resize:vertical}.chat-messages{height:440px;overflow:auto;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:8px}.chat-msg{background:#fff;border:1px solid #edf2f7;border-radius:9px;padding:8px;margin-bottom:6px;font-size:12px}.chat-msg b{display:block}.chat-form{display:flex;gap:7px;margin-top:8px}.question-box{margin-top:10px;padding:10px;background:#fff8e6;border:1px solid #fde68a;border-radius:10px}.video-pip{position:absolute;right:18px;bottom:18px;width:min(280px,30%);aspect-ratio:16/9;background:#000;border-radius:12px;overflow:hidden;z-index:20;box-shadow:0 12px 32px rgba(0,0,0,.25)}.video-pip.remote{right:18px;bottom:calc(18px + min(280px,30%)*.5625 + 12px)}.video-pip video{width:100%;height:100%;object-fit:cover}.pip-label{position:absolute;left:8px;bottom:6px;background:rgba(0,0,0,.5);color:#fff;border-radius:6px;padding:2px 6px;font-size:10px}.write-permission-bar{position:absolute;left:14px;right:14px;bottom:14px;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 11px;border-radius:10px;background:rgba(15,23,42,.92);color:#fff;font-size:12px}.write-permission-bar.teacher{left:auto;right:14px;max-width:450px}.writer-member{display:flex;align-items:center;justify-content:space-between;gap:8px;border:1px solid #e2e8f0;border-radius:8px;padding:8px;margin-bottom:6px;background:#fff}.qmode-card{border:1px solid #e2e8f0;border-radius:8px;padding:9px;background:#f8fafc}
@media(max-width:1100px){.classroom-main{grid-template-columns:70px minmax(0,1fr)}.classroom-right{position:absolute;right:0;top:58px;bottom:0;width:min(92vw,360px);z-index:50;transform:translateX(100%);transition:.2s;box-shadow:-10px 0 30px rgba(15,23,42,.15)}.classroom-right.mobile-open{transform:translateX(0)}.classroom-app{height:calc(100vh - 72px);min-height:560px}}
@media(max-width:700px){.classroom-topbar{height:auto;min-height:58px;align-items:flex-start}.room-title-wrap{min-width:0}.top-controls{justify-content:flex-end;gap:4px}.classroom-tools{width:66px}.side-tool{font-size:9px;padding:7px 2px}.book-viewport{padding:12px}.book-pages{width:96%}.video-pip{width:42vw}.video-pip.remote{bottom:calc(18px + 42vw*.5625 + 8px)}}
</style>
<script src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.js"></script><script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script><script src="/socket.io/socket.io.js"></script>
<script>window.CLASSROOM=<%-JSON.stringify({room:room.room_code,isTeacher,currentUser:req?.session?.user?.name || req?.session?.adminUser?.name || (isTeacher?'Giáo viên':'Học viên'),currentUserId:req?.session?.user?.id || req?.session?.adminUser?.id || null,initialPdf:Boolean(room.pdf_url)})%>;</script>
<script src="/js/classroom-permissions.js"></script><script src="/js/classroom.js"></script><%- include('partials/footer') %>