<% var pageTitle=lesson.title %><%- include('partials/header') %>
<div class="row g-4"><div class="col-lg-8"><div class="card border-0 shadow-sm p-4"><div class="d-flex justify-content-between align-items-start gap-3"><div><div class="small text-muted">Sách học theo bài</div><h3 class="fw-bold"><%=lesson.title%></h3></div><a href="/sach/hoc/<%=lesson.id%>/tu-luyen" class="btn btn-warning"><i class="fa-solid fa-pen-to-square me-1"></i>Bài tự luyện</a></div><%if(lesson.content){%><div class="mb-4 mt-2"><%-lesson.content%></div><%}%>
<%lesson.videos.forEach(v=>{%><div class="ratio ratio-16x9 bg-dark rounded mb-3"><%if(v.source_type==='youtube'){%><iframe src="https://www.youtube-nocookie.com/embed/<%=v.source_value%>" allowfullscreen></iframe><%}else if(v.source_type==='vimeo'){%><iframe src="https://player.vimeo.com/video/<%=v.source_value%>" allowfullscreen></iframe><%}else if(v.source_type==='drive'){%><iframe src="<%=v.source_value.replace('/view','/preview')%>" allowfullscreen></iframe><%}else{%><video controls><source src="<%=v.source_value%>"></video><%}%></div><%})%>
<%if(lesson.files.length){%><h5 class="fw-bold mt-4">Tài liệu</h5><div class="list-group mb-3"><%lesson.files.forEach(f=>{%><a class="list-group-item list-group-item-action" href="<%=f.file_url%>" target="_blank" rel="noopener"><i class="fa-solid fa-file-pdf text-danger me-2"></i><%=f.title%><%if(f.is_free){%><span class="badge bg-success ms-2">Miễn phí</span><%}%></a><%})%></div><%}%>
<div class="alert alert-light border small mb-0"><b>Phòng học:</b> nếu giáo viên mở phòng cho bài này, học sinh có thể vào mục <a href="/phong-hoc">Phòng học</a> để học trực tiếp với sách, bảng viết và note.</div></div></div><div class="col-lg-4"><div class="card border-0 shadow-sm p-4"><h6 class="fw-bold">Tiến trình bài</h6><div class="small text-muted mb-3">Video và tài liệu của bài được quản lý riêng; bài tự luyện cũng nằm riêng để học sinh làm sau khi học.</div><a href="/sach/hoc/<%=lesson.id%>/tu-luyen" class="btn btn-outline-warning w-100"><i class="fa-solid fa-list-check me-1"></i>Mở bài tự luyện</a></div></div></div>
<%- include('partials/footer') %>
