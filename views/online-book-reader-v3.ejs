<% var pageTitle='Đọc: '+book.title %><%- include('partials/header') %><link rel="stylesheet" href="/css/reader-v3.css"><link rel="stylesheet" href="/css/pageflip-v4.css">
<div id="r3App" class="reader-v3">
  <% if(!unlocked){ %><div style="position:absolute;inset:0;z-index:100;background:rgba(15,23,42,.72);display:flex;align-items:center;justify-content:center;padding:20px"><div class="bg-white rounded-4 p-4 text-center" style="max-width:420px"><h4>🔒 Sách chưa được mở khóa</h4><p class="text-muted">Hãy đăng nhập và mua/được cấp quyền đọc sách này.</p><a href="/doc-sach-online/<%=book.slug%>" class="btn btn-primary">Quay lại sách</a></div></div><% } %>
  <header class="r3-head"><div class="r3-title"><h5><%=book.title%></h5><div class="r3-sub">📖 Sách lật thật · ← → · chuột · vuốt · zoom · note · bút · đánh dấu</div></div><div class="r3-controls"><button id="r3Toc" class="r3-btn">☰ Mục lục</button><button id="r3Prev" class="r3-btn" title="Trang trước">←</button><label class="r3-page"><input id="r3PageInput" type="number" min="1" value="1"><span>/ <b id="r3Total">1</b></span></label><button id="r3Next" class="r3-btn" title="Trang sau">→</button><button id="r3ZoomOut" class="r3-btn">−</button><span id="r3ZoomLabel">100%</span><button id="r3ZoomIn" class="r3-btn">+</button><button id="r3Fit" class="r3-btn">Fit</button><button id="r3Full" class="r3-btn">⛶</button><button id="r3ToolsToggle" class="r3-btn">☰</button></div></header>
  <div class="r3-body"><main id="r3Stage" class="r3-stage"><div id="r3BookWrap" class="r3-book-wrap"><div id="r3Book" class="r3-book"></div></div><div id="r3Loading" class="r3-loading hidden"><div class="spinner-border"></div><div class="mt-2">Đang tải sách…</div></div><div class="r3-hint">← Kéo/chuột/vuốt sang trái phải để lật trang →</div>
    <aside id="r3TocPanel" class="r3-toc hidden"><div class="d-flex justify-content-between align-items-center mb-2"><b>MỤC LỤC</b><button id="r3TocClose" class="btn-close"></button></div><% if(manualToc?.length){ manualToc.forEach(t=>{ %><button class="r3-toc-item" data-toc-page="<%=Math.max(0,Number(t.page_number)-1)%>"><%=t.title%> · trang <%=t.page_number%></button><% }) } else if(chapters?.length){ chapters.forEach((c,i)=>{ %><button class="r3-toc-item" data-toc-page="<%=i%>"><%=c.title%></button><% }) } else { %><div class="small text-muted">Chưa có mục lục.</div><% } %></aside>
  </main><aside class="r3-tools"><div class="r3-tools-title">CÔNG CỤ ĐỌC SÁCH</div><button id="r3Bookmark" class="r3-tool"><i class="fa-regular fa-bookmark"></i>Đánh dấu trang</button><button id="r3NoteBtn" class="r3-tool"><i class="fa-regular fa-note-sticky"></i>Ghi chú trang</button><button class="r3-tool active" data-mode="pointer"><i class="fa-solid fa-hand"></i>Chuột / Lật trang</button><button class="r3-tool" data-mode="pen"><i class="fa-solid fa-pencil"></i>Viết bằng bút</button><button class="r3-tool" data-mode="highlight"><i class="fa-solid fa-highlighter"></i>Đánh dấu</button><button class="r3-tool" data-mode="eraser"><i class="fa-solid fa-eraser"></i>Tẩy</button><button id="r3ClearInk" class="r3-tool"><i class="fa-regular fa-trash-can"></i>Xóa nét trang</button><div class="r3-pen-box"><div class="small fw-bold">Màu bút</div><div class="r3-colors"><button class="r3-color active" data-color="#ef4444" style="background:#ef4444"></button><button class="r3-color" data-color="#2563eb" style="background:#2563eb"></button><button class="r3-color" data-color="#111827" style="background:#111827"></button><button class="r3-color" data-color="#16a34a" style="background:#16a34a"></button></div><select id="r3PenWidth" class="form-select form-select-sm"><option value="1.5">Nét mảnh</option><option value="3" selected>Nét vừa</option><option value="5">Nét đậm</option><option value="8">Nét rất đậm</option><option value="12">Nét siêu đậm</option></select></div></aside></div>
  <div id="r3Note" class="r3-note hidden"><div class="d-flex justify-content-between align-items-center"><b>Ghi chú trang <span id="r3NotePage">1</span></b><button id="r3NoteClose" class="btn-close"></button></div><div class="r3-note-templates"><button data-note-template="paper">📄</button><button data-note-template="lined">☰</button><button data-note-template="grid">▦</button><button data-note-template="dot">⠿</button><button data-note-template="dark">🌙</button></div><div class="d-flex gap-2 mb-2"><select id="r3NoteSize" class="form-select form-select-sm"><option value="14">14</option><option value="16" selected>16</option><option value="18">18</option><option value="20">20</option></select><button id="r3ClearNote" class="btn btn-outline-danger btn-sm">Xóa</button></div><textarea id="r3NoteText" class="note-paper" placeholder="Ghi công thức, ý chính, câu hỏi…"></textarea><div class="small text-success mt-1">✓ Tự lưu trên thiết bị</div></div>
  <% if(mode==='chapters'){ chapters.forEach((c,i)=>{ if(c.unlocked){ %><div class="chapter-source" hidden><h2><%=c.title%></h2><%-c.content||''%></div><% }}) } %>
</div><div id="r3Toast" class="r3-toast"></div>
<script>window.READER_CONFIG=<%-JSON.stringify({slug:book.slug,mode,fileUrl:mode==='pdf'?('/doc-sach-online/'+book.slug+'/file'):null})%>;</script><script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script><script>if(window.pdfjsLib)pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';</script><script src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.js"></script><script src="/js/pageflip-config.js?v=20260821-1"></script><script src="/js/reader-v3.js?v=20260821-1"></script>
