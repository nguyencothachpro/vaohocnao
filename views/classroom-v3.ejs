<% var pageTitle=room.title %><%- include('partials/header') %>
<link rel="stylesheet" href="/css/classroom-v3.css"><link rel="stylesheet" href="/css/pageflip-v4.css">
<div id="c3App" class="classroom-v3">
  <% if(!isTeacher && !member){ %><div class="c3-access"><div class="c3-access-card"><div style="font-size:36px">🎓</div><h3>Vào lớp <%=room.title%></h3><div class="code">Mã phòng: <b><%=room.room_code%></b></div><form method="post" action="/phong-hoc/<%=room.room_code%>/vao" class="mt-3"><input name="student_code" class="form-control form-control-lg" placeholder="Nhập mã học viên" autocomplete="off" required><button class="btn btn-primary btn-lg w-100 mt-3">Vào lớp</button></form><div class="small text-muted mt-3">Mỗi học viên có một mã riêng. Giáo viên có thể tạo hàng loạt mã tối đa 5.000 học viên/lớp.</div></div></div><% } %>
  <header class="c3-top"><div class="c3-top-left"><a class="c3-btn" href="/phong-hoc">← Phòng</a><div class="c3-title"><strong><%=room.title%></strong><div class="c3-sub">Mã <%=room.room_code%> · <%=isTeacher?'GIÁO VIÊN':(member?.display_name||'HỌC VIÊN')%></div></div></div><div class="c3-top-right"><button id="c3Prev" class="c3-btn" title="Trang trước">←</button><button id="c3Next" class="c3-btn" title="Trang sau">→</button><label class="c3-page"><span>Trang</span><input id="c3PageInput" value="1" type="number" min="1"><span>/ <b id="c3Total">1</b></span></label><button id="c3ZoomOut" class="c3-btn">−</button><span id="c3Zoom" class="c3-zoom">100%</span><button id="c3ZoomIn" class="c3-btn">+</button><button id="c3Fit" class="c3-btn">Fit</button><button id="c3Full" class="c3-btn">⛶</button><button id="c3PanelToggle" class="c3-btn">☰</button></div></header>
  <div class="c3-body">
    <aside class="c3-tools"><div class="c3-section">ĐIỀU KHIỂN</div><button class="c3-tool active" data-mode="pointer"><i class="fa-solid fa-hand"></i>Chuột</button><button class="c3-tool" data-mode="pen"><i class="fa-solid fa-pencil"></i>Bút</button><button class="c3-tool" data-mode="highlighter"><i class="fa-solid fa-highlighter"></i>Đánh dấu</button><button class="c3-tool" data-mode="eraser"><i class="fa-solid fa-eraser"></i>Tẩy</button><button id="c3Clear" class="c3-tool"><i class="fa-regular fa-trash-can"></i>Xóa nét</button><% if(!isTeacher && !member?.can_write){ %><button id="c3RequestWrite" class="c3-tool"><i class="fa-regular fa-hand"></i>Xin quyền viết</button><% } %><div class="c3-options"><label>Màu bút</label><div class="c3-colors"><button class="c3-color active" data-color="#ef4444" style="background:#ef4444"></button><button class="c3-color" data-color="#2563eb" style="background:#2563eb"></button><button class="c3-color" data-color="#111827" style="background:#111827"></button><button class="c3-color" data-color="#16a34a" style="background:#16a34a"></button></div><label>Độ dày</label><select id="c3PenWidth" class="form-select form-select-sm"><option value="1.5">Mảnh</option><option value="3" selected>Vừa</option><option value="5">Đậm</option><option value="8">Rất đậm</option><option value="12">Siêu đậm</option></select><select id="c3HighWidth" class="form-select form-select-sm"><option value="12">Highlight mảnh</option><option value="20" selected>Highlight vừa</option><option value="30">Highlight đậm</option></select></div><div class="c3-divider"></div><div class="c3-section">TÀI LIỆU</div><button class="c3-tool" onclick="document.querySelector('.c3-right').classList.toggle('open')"><i class="fa-solid fa-book-open"></i>Tài liệu</button><button class="c3-tool" onclick="document.querySelector('[data-panel=notes]').click()"><i class="fa-regular fa-note-sticky"></i>Note</button><button class="c3-tool" onclick="document.querySelector('[data-panel=chat]').click()"><i class="fa-regular fa-comments"></i>Chat</button></aside>
    <main id="c3Stage" class="c3-stage"><div class="c3-stagebar"><span><b>Bảng giảng</b> · sách lật thật · kéo/chuột/vuốt sang trái phải</span><span id="c3Presence">Đang kết nối...</span></div><div id="c3View" class="c3-view"><div id="c3BookWrap" class="c3-book-wrap"><div id="c3Book" class="c3-book"></div></div><div id="c3Empty" class="c3-empty <%=room.pdf_url?'hidden':''%>"><i class="fa-solid fa-book-open"></i><h5>Sẵn sàng giảng bài</h5><p>Chọn PDF hoặc tạo sổ trắng. Dùng <b>Chuột</b> để lật như sách thật và <b>Bút</b> để viết.</p></div><div id="c3Loading" class="c3-empty hidden"><div class="spinner-border"></div><h5>Đang tải tài liệu…</h5></div><div class="c3-badge">← Kéo góc/chuột/vuốt để lật →</div></div></main>
    <aside class="c3-right"><div class="c3-tabs"><button class="c3-tab active" data-panel="materials">📚 Tài liệu</button><button class="c3-tab" data-panel="notes">📝 Note</button><button class="c3-tab" data-panel="chat">💬 Chat <span id="chatUnread" class="c3-unread d-none">0</span></button></div>
      <section id="panel-materials" class="c3-panel active"><div class="c3-heading">Tài liệu trong phòng</div><div class="c3-muted mb-2">Tài liệu được mở trực tiếp trên quyển sách lật, không dùng vùng cuộn dọc để đọc.</div><div class="c3-heading mt-3">SỔ TRẮNG LẬT NHƯ SÁCH</div><div class="c3-templates"><% [['paper','Giấy trắng'],['lined','Kẻ ngang'],['grid','Ô ly'],['dot','Chấm bi'],['cornell','Cornell'],['math','Toán']].forEach(x=>{ %><button class="c3-template" data-blank-template="<%=x[0]%>"><span class="c3-preview blank-<%=x[0]%>"></span><%=x[1]%></button><% }) %></div><button id="c3NewBlank" class="btn btn-outline-primary btn-sm w-100 mt-2">＋ Thêm trang cùng mẫu</button><% if(room.pdf_url){ %><div class="c3-heading mt-3">PDF bài giảng</div><button class="c3-material" data-open-pdf="/phong-hoc/<%=room.room_code%>/pdf"><strong>📕 Mở PDF bài giảng</strong><small>Lật từng trang như sách</small></button><% } %><% materials.forEach(m=>{ %><button class="c3-material" data-material-url="<%=m.url||''%>" data-material-kind="<%=m.kind||'link'%>"><strong>📎 <%=m.title%></strong><small><%=m.kind||'link'%> · Bấm để mở</small></button><% }) %><% if(isTeacher){ %><hr><div class="c3-heading">Thêm tài liệu</div><form method="post" action="/admin/phong-hoc/tai-lieu"><input type="hidden" name="classroom_id" value="<%=room.id%>"><input type="hidden" name="room_code" value="<%=room.room_code%>"><input name="title" class="form-control form-control-sm mb-2" placeholder="Tên tài liệu" required><input name="url" class="form-control form-control-sm mb-2" placeholder="Link PDF / Drive / ảnh / YouTube" required><select name="kind" class="form-select form-select-sm mb-2"><option value="pdf">PDF</option><option value="image">Ảnh</option><option value="video">Video</option><option value="link">Link</option></select><button class="btn btn-primary btn-sm w-100">＋ Thêm tài liệu</button></form><% } %></section>
      <section id="panel-notes" class="c3-panel"><div class="c3-heading">Sổ ghi chú cá nhân</div><div class="c3-muted">Note đẹp, nhiều mẫu, tự lưu trên thiết bị của học viên/giáo viên.</div><div class="c3-templates mt-2"><% [['paper','Giấy'],['lined','Kẻ dòng'],['grid','Ô ly'],['dot','Chấm bi'],['dark','Tối']].forEach(x=>{ %><button class="c3-template" data-note-template="<%=x[0]%>"><span class="c3-preview note-<%=x[0]%>"></span><%=x[1]%></button><% }) %></div><div class="c3-note-toolbar"><select id="c3NoteSize" class="form-select form-select-sm"><option value="14">Chữ 14</option><option value="16" selected>Chữ 16</option><option value="18">Chữ 18</option><option value="20">Chữ 20</option></select><button id="clearNotes" class="btn btn-outline-danger btn-sm">Xóa</button></div><textarea id="c3Notes" class="c3-notes note-paper" placeholder="Ghi công thức, ý chính, bài tập, câu hỏi…"></textarea><div class="small text-success mt-2">✓ Tự lưu</div></section>
      <section id="panel-chat" class="c3-panel"><div class="c3-heading">Chat lớp học</div><div class="c3-muted mb-2">Tin nhắn chỉ hiện trong phòng. Badge chỉ báo số tin chưa đọc để tránh làm rối khi lớp đông.</div><div id="c3Chat" class="c3-chat"></div><form id="c3ChatForm" class="c3-chat-form"><input id="c3ChatInput" class="form-control form-control-sm" maxlength="500" placeholder="Nhắn tin…"><button class="btn btn-primary btn-sm">Gửi</button></form></section>
      <section id="panel-requests" class="c3-panel"><div class="c3-heading">Yêu cầu quyền viết</div><div class="c3-muted mb-2">Chỉ giáo viên mới có quyền quyết định học viên nào được viết.</div><div id="c3Requests"></div></section><div class="c3-status"><span class="c3-dot"></span><span id="c3Presence">Đang kết nối</span></div></aside>
  </div>
</div><div id="c3Toast" class="c3-toast"></div>
<script>window.CLASSROOM=<%-JSON.stringify({room:room.room_code,pdfUrl:room.pdf_url?('/phong-hoc/'+room.room_code+'/pdf'):null,isTeacher:Boolean(isTeacher),canWrite:Boolean(isTeacher||member?.can_write),canNavigate:Boolean(isTeacher||room.status!=='live'||member?.can_navigate),roomStatus:room.status,askTeacherEnabled:settings?.ask_teacher_enabled!==false})%>;</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script><script>if(window.pdfjsLib)pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';</script><script src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.js"></script><script src="/js/pageflip-config.js?v=20260821-2"></script><script src="/socket.io/socket.io.js"></script><script src="/js/classroom-v3.js?v=20260821-4"></script><script src="/js/classroom-live-sync.js?v=20260821-4"></script><script src="/js/classroom-permission-lock.js?v=20260821-4"></script><script src="/js/classroom-eraser-upgrade.js?v=20260821-2"></script>
