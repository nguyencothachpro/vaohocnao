<% var pageTitle='Phòng học trực tuyến' %>
<%- include('../partials/admin-header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h5 class="fw-bold mb-1">Phòng học = không gian dạy học</h5>
    <div class="text-muted small">Mỗi phòng có bảng viết, sách/PDF, note, tài liệu, camera/mic, chia sẻ màn hình và đồng bộ realtime.</div>
  </div>
  <a href="/phong-hoc" target="_blank" rel="noopener" class="btn btn-outline-primary"><i class="fa-solid fa-eye me-1"></i>Xem phòng đang mở</a>
</div>

<div class="card p-4 mb-4 border-0 shadow-sm">
  <h5 class="fw-bold mb-3"><i class="fa-solid fa-plus-circle text-primary me-1"></i>Tạo phòng học mới</h5>
  <form method="post" action="/admin/phong-hoc" class="row g-3">
    <div class="col-lg-5"><label class="form-label fw-semibold">Tên buổi học / lớp</label><input name="title" class="form-control form-control-lg" placeholder="Ví dụ: Toán 12 — Chương Nguyên hàm" required></div>
    <div class="col-lg-3"><label class="form-label fw-semibold">YouTube Live / OBS</label><input name="live_url" class="form-control" placeholder="Tùy chọn — dùng cho lớp đông"></div>
    <div class="col-lg-4"><label class="form-label fw-semibold">PDF mở sẵn</label><input name="pdf_url" class="form-control" placeholder="Link PDF/Drive tùy chọn"></div>
    <div class="col-12"><button class="btn btn-primary px-4"><i class="fa-solid fa-door-open me-1"></i>Mở phòng ngay</button></div>
  </form>
</div>

<div class="row g-3">
<% rooms.forEach(r=>{ %>
  <div class="col-xl-6">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between gap-3">
          <div><div class="small text-muted mb-1">PHÒNG HỌC</div><h5 class="fw-bold mb-1"><%= r.title %></h5><div class="small text-muted">Giáo viên: <%= r.teacher_name || '—' %></div></div>
          <span class="badge rounded-pill align-self-start <%= r.status==='live'?'bg-success':'bg-secondary' %>"><%= r.status==='live'?'ĐANG MỞ':'ĐÃ ĐÓNG' %></span>
        </div>
        <div class="p-3 rounded-3 my-3" style="background:#f7f8fb">
          <div class="small text-muted">Mã phòng</div><div class="d-flex align-items-center gap-2"><code class="fs-5 fw-bold" id="code-<%=r.id%>"><%=r.room_code%></code><button type="button" class="btn btn-sm btn-outline-secondary" onclick="navigator.clipboard.writeText('<%=r.room_code%>')"><i class="fa-regular fa-copy"></i></button></div>
          <div class="small text-muted mt-2">Link học sinh</div><div class="d-flex gap-2"><input readonly class="form-control form-control-sm" value="<%= '/phong-hoc/' + r.room_code %>" id="url-<%=r.id%>"><button type="button" class="btn btn-sm btn-outline-secondary" onclick="navigator.clipboard.writeText(location.origin+'/phong-hoc/<%=r.room_code%>')"><i class="fa-regular fa-copy"></i></button></div>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-primary" href="/phong-hoc/<%=r.room_code%>"><i class="fa-solid fa-chalkboard-user me-1"></i>Vào phòng</a>
          <% if(r.status==='live'){ %><form method="post" action="/admin/phong-hoc/<%=r.id%>/dong" class="d-inline"><button class="btn btn-outline-danger"><i class="fa-solid fa-stop me-1"></i>Đóng phòng</button></form><% } %>
        </div>
      </div>
    </div>
  </div>
<% }) %>
<% if (!rooms.length) { %><div class="col-12"><div class="card border-0 shadow-sm p-5 text-center"><i class="fa-solid fa-chalkboard-user fa-3x text-muted mb-3"></i><h5>Chưa có phòng học</h5><p class="text-muted mb-3">Tạo phòng đầu tiên ở khung phía trên. Sau khi mở, học sinh chỉ cần mã phòng hoặc link phòng để vào.</p></div></div><% } %>
</div>
<%- include('../partials/admin-footer') %>
