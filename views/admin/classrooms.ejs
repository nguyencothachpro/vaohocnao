<% var pageTitle='Phòng học & Lớp học' %>
<%- include('../partials/admin-header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div><h5 class="fw-bold mb-1">Phòng học & quản lý lớp</h5><div class="text-muted small">Mỗi lớp có danh sách học viên riêng, mã học viên riêng và quyền viết riêng. Giáo viên tự quyết định sĩ số.</div></div>
  <a href="/phong-hoc" target="_blank" rel="noopener" class="btn btn-outline-primary">Xem giao diện học viên</a>
</div>

<div class="card p-4 mb-4 border-0 shadow-sm">
  <h5 class="fw-bold mb-3">+ Tạo lớp / phòng học</h5>
  <form method="post" action="/admin/phong-hoc" class="row g-3">
    <div class="col-lg-4"><label class="form-label fw-semibold">Tên lớp</label><input name="title" class="form-control form-control-lg" placeholder="Ví dụ: Toán 11A1" required></div>
    <div class="col-lg-2"><label class="form-label fw-semibold">Số học viên</label><input name="student_count" type="number" min="0" max="5000" value="30" class="form-control form-control-lg"><div class="form-text">Tối đa 5.000/lớp</div></div>
    <div class="col-lg-2"><label class="form-label fw-semibold">Tiền tố mã</label><input name="student_prefix" value="HS" class="form-control form-control-lg" maxlength="12"></div>
    <div class="col-lg-4"><label class="form-label fw-semibold">PDF mở sẵn (tùy chọn)</label><input name="pdf_url" class="form-control" placeholder="Link PDF/Drive"></div>
    <div class="col-lg-8"><label class="form-label fw-semibold">YouTube Live / OBS (tùy chọn)</label><input name="live_url" class="form-control" placeholder="Dùng khi lớp đông để giảm tải camera/WebRTC"></div>
    <div class="col-lg-4 d-flex align-items-end"><button class="btn btn-primary btn-lg w-100">Mở lớp & tạo mã học viên</button></div>
  </form>
  <div class="small text-muted mt-3">Ví dụ 30 học viên với tiền tố HS sẽ tạo HS001 → HS030. Có thể nhập bất kỳ sĩ số nào từ 0 đến 5.000; hệ thống không bắt buộc lớp phải đủ 5.000.</div>
</div>

<div class="row g-3">
<% rooms.forEach(r=>{ %>
  <div class="col-xl-6">
    <div class="card h-100 border-0 shadow-sm"><div class="card-body p-4">
      <div class="d-flex justify-content-between gap-3"><div><div class="small text-muted">LỚP HỌC</div><h5 class="fw-bold mb-1"><%=r.title%></h5><div class="small text-muted">Giáo viên: <%=r.teacher_name||'—'%></div></div><span class="badge rounded-pill <%=r.status==='live'?'bg-success':'bg-secondary'%>"><%=r.status==='live'?'ĐANG MỞ':'ĐÃ ĐÓNG'%></span></div>
      <div class="row g-2 my-3"><div class="col-4"><div class="p-3 bg-light rounded-3"><div class="small text-muted">Học viên</div><b><%=r.student_count||0%></b></div></div><div class="col-4"><div class="p-3 bg-light rounded-3"><div class="small text-muted">Online</div><b><%=r.online_count||0%></b></div></div><div class="col-4"><div class="p-3 bg-light rounded-3"><div class="small text-muted">Mã phòng</div><b><%=r.room_code%></b></div></div></div>
      <div class="d-flex flex-wrap gap-2"><a class="btn btn-primary" href="/admin/phong-hoc/<%=r.id%>">Quản lý lớp</a><a class="btn btn-outline-primary" href="/phong-hoc/<%=r.room_code%>">Vào phòng</a><button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText(location.origin+'/phong-hoc/<%=r.room_code%>')">Copy link</button><%if(r.status==='live'){%><form method="post" action="/admin/phong-hoc/<%=r.id%>/dong"><button class="btn btn-outline-danger">Đóng lớp</button></form><%}%></div>
    </div></div>
  </div>
<% }) %>
<%if(!rooms.length){%><div class="col-12"><div class="card border-0 shadow-sm p-5 text-center"><h5>Chưa có lớp</h5><p class="text-muted mb-0">Tạo lớp ở phía trên.</p></div></div><%}%>
</div>
<%- include('../partials/admin-footer') %>
