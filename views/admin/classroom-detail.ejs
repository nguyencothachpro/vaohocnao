<% var pageTitle='Quản lý lớp — '+room.title %>
<%- include('../partials/admin-header') %>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><a href="/admin/phong-hoc" class="btn btn-sm btn-outline-secondary mb-2">← Danh sách lớp</a><h4 class="fw-bold mb-1"><%=room.title%></h4><div class="text-muted">Mã phòng: <code><%=room.room_code%></code> · Giáo viên: <%=room.teacher_name||'—'%></div></div><a href="/phong-hoc/<%=room.room_code%>" target="_blank" class="btn btn-primary">Mở phòng</a></div>

<div class="row g-3 mb-4">
  <div class="col-lg-8"><div class="card border-0 shadow-sm"><div class="card-body"><h5 class="fw-bold">Thêm học viên</h5><form method="post" action="/admin/phong-hoc/<%=room.id%>/hoc-vien" class="row g-2"><div class="col-md-3"><input name="count" type="number" min="1" max="500" value="10" class="form-control" placeholder="Số lượng"></div><div class="col-md-3"><input name="start_number" type="number" min="1" value="1" class="form-control" placeholder="Bắt đầu từ"></div><div class="col-md-3"><input name="prefix" value="HS" maxlength="12" class="form-control" placeholder="Tiền tố"></div><div class="col-md-3"><button class="btn btn-primary w-100">+ Tạo mã</button></div></form><div class="small text-muted mt-2">Mã được lưu trong hệ thống. Không dùng mã phòng thay cho mã học viên.</div></div></div></div>
  <div class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body"><h5 class="fw-bold">Hỏi giáo viên</h5><form method="post" action="/admin/phong-hoc/<%=room.id%>/cau-hinh"><div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="ask_teacher_enabled" value="true" id="ask" <%=settings.ask_teacher_enabled?'checked':''%>><label class="form-check-label" for="ask">Cho phép học viên hỏi giáo viên</label></div><button class="btn btn-outline-primary btn-sm">Lưu cài đặt</button></form><div class="small text-muted mt-2">Tắt khi lớp đông để tránh thông báo/chat làm giáo viên bị rối.</div></div></div></div>
</div>

<div class="card border-0 shadow-sm"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-3"><div><h5 class="fw-bold mb-0">Danh sách học viên</h5><div class="small text-muted"><%=students.length%> học viên · Giáo viên có thể cấp quyền viết từng người.</div></div><button class="btn btn-outline-secondary btn-sm" onclick="window.print()">In danh sách mã</button></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>#</th><th>Học viên</th><th>Mã riêng</th><th>Trạng thái</th><th>Quyền bảng</th><th>Online gần đây</th><th></th></tr></thead><tbody>
<%students.forEach((s,i)=>{%><tr><td><%=i+1%></td><td><input form="f<%=s.id%>" name="display_name" value="<%=s.display_name%>" class="form-control form-control-sm" style="min-width:160px"></td><td><code class="fw-bold"><%=s.student_code%></code></td><td><select form="f<%=s.id%>" name="status" class="form-select form-select-sm"><option value="active" <%=s.status==='active'?'selected':''%>>Hoạt động</option><option value="blocked" <%=s.status==='blocked'?'selected':''%>>Khóa</option></select></td><td><div class="form-check form-switch"><input form="f<%=s.id%>" class="form-check-input" type="checkbox" name="can_write" value="true" <%=s.can_write?'checked':''%>><label class="form-check-label small">Được viết</label></div></td><td class="small text-muted"><%=s.last_seen?new Date(s.last_seen).toLocaleString('vi-VN'): 'Chưa vào'%></td><td><form id="f<%=s.id%>" method="post" action="/admin/phong-hoc/<%=room.id%>/hoc-vien/<%=s.id%>" class="d-flex gap-1"><button class="btn btn-sm btn-primary">Lưu</button></form><form method="post" action="/admin/phong-hoc/<%=room.id%>/hoc-vien/<%=s.id%>/xoa" onsubmit="return confirm('Xóa học viên này?')"><button class="btn btn-sm btn-outline-danger mt-1">Xóa</button></form></td></tr><%})%>
<%if(!students.length){%><tr><td colspan="7" class="text-center text-muted py-5">Chưa có học viên.</td></tr><%}%></tbody></table></div></div></div>
<%- include('../partials/admin-footer') %>
