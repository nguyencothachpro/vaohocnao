<% var isBook = parentType === 'book'; var entity = parent || course; var pageTitle = (isBook ? 'Nội dung sách: ' : 'Nội dung khóa học: ') + entity.title; %>
<%- include('../../partials/admin-header') %>
<style>
.content-toolbar{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:14px;position:sticky;top:10px;z-index:20;box-shadow:0 8px 24px rgba(15,23,42,.06)}
.tree-card{border:1px solid #e5e7eb;border-radius:14px;background:#fff;margin-bottom:14px;overflow:hidden}.tree-head{padding:14px 16px;background:#f8fafc;border-bottom:1px solid #e5e7eb}.lesson-row{border-bottom:1px dashed #e5e7eb;padding:12px 14px}.lesson-row:last-child{border-bottom:0}.drag{cursor:grab;color:#94a3b8}.resource{background:#f8fafc;border-radius:9px;padding:8px 10px;margin-top:7px}.badge-free{background:#dcfce7;color:#166534}.badge-lock{background:#f1f5f9;color:#475569}.dropzone{min-height:8px}.muted-note{font-size:12px;color:#64748b}
</style>
<div class="content-toolbar mb-3">
  <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
    <div><a href="<%= isBook ? '/admin/sach' : '/admin/khoa-hoc' %>" class="btn btn-sm btn-outline-secondary">← Quay lại</a><span class="ms-2 fw-bold"><%= entity.title %></span></div>
    <div class="d-flex gap-2"><button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#chapterModal">＋ Chương</button><span class="muted-note align-self-center">Kéo chương/bài để sắp xếp • có thể kéo bài sang chương khác</span></div>
  </div>
</div>
<div id="chapterList">
<% chapters.forEach((ch,ci)=>{ %>
  <section class="tree-card chapter-card" data-id="<%= ch.id %>">
    <div class="tree-head d-flex justify-content-between align-items-center">
      <div><span class="drag chapter-handle me-2">☷</span><strong>Chương <%= ci+1 %>. <%= ch.title %></strong><span class="badge bg-light text-dark ms-2"><%= ch.lessons.length %> bài</span></div>
      <div class="d-flex gap-1">
        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#lessonModal" data-chapter="<%= ch.id %>">＋ Bài học</button>
        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editChapterModal" data-id="<%= ch.id %>" data-title="<%= ch.title.replace(/"/g,'&quot;') %>">Sửa</button>
        <form method="POST" action="/admin/chuong/<%= ch.id %>/xoa" class="d-inline" onsubmit="return confirm('Xóa chương và toàn bộ bài bên trong?')"><input type="hidden" name="parent_type" value="<%= parentType %>"><input type="hidden" name="parent_id" value="<%= entity.id %>"><button class="btn btn-sm btn-outline-danger">Xóa</button></form>
      </div>
    </div>
    <div class="lesson-list dropzone" data-chapter="<%= ch.id %>">
      <% ch.lessons.forEach((l,li)=>{ %>
      <article class="lesson-row" data-id="<%= l.id %>">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <div><span class="drag lesson-handle me-2">☷</span><strong><%= li+1 %>. <%= l.title %></strong> <% if(l.is_preview){ %><span class="badge badge-free ms-1">Học thử</span><% } %></div>
          <div class="d-flex flex-wrap gap-1">
            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#videoModal" data-lesson="<%= l.id %>">＋ Video</button>
            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#fileModal" data-lesson="<%= l.id %>">＋ Tài liệu</button>
            <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editLessonModal" data-id="<%= l.id %>" data-title="<%= l.title.replace(/"/g,'&quot;') %>" data-content="<%= (l.content||'').replace(/"/g,'&quot;').replace(/\n/g,' ') %>" data-preview="<%= l.is_preview ? '1':'0' %>">Sửa</button>
            <a href="/admin/bai-hoc/<%= l.id %>/bai-kiem-tra" class="btn btn-sm btn-outline-warning"><%= l.quiz?'Sửa bài tập':'+ Bài tập' %></a>
            <form method="POST" action="/admin/bai-hoc/<%= l.id %>/xoa" class="d-inline" onsubmit="return confirm('Xóa bài học?')"><input type="hidden" name="parent_type" value="<%= parentType %>"><input type="hidden" name="parent_id" value="<%= entity.id %>"><button class="btn btn-sm btn-outline-danger">Xóa</button></form>
          </div>
        </div>
        <% if(l.content){ %><div class="small text-muted mt-2 ms-4"><%- l.content %></div><% } %>
        <div class="ms-4 mt-2">
          <% l.videos.forEach(v=>{ %><div class="resource d-flex justify-content-between align-items-center"><div><span class="text-primary">▶</span> <strong><%= v.title %></strong> <span class="badge bg-light text-dark"><%= v.source_type %></span> <% if(v.is_free){ %><span class="badge badge-free">Miễn phí</span><% }else{ %><span class="badge badge-lock">Có quyền</span><% } %><% if(v.duration_seconds){ %><span class="muted-note ms-2"><%= Math.floor(v.duration_seconds/60) %>m <%= v.duration_seconds%60 %>s</span><% } %></div><div><button class="btn btn-sm btn-link" data-bs-toggle="modal" data-bs-target="#editVideoModal" data-id="<%=v.id%>" data-title="<%=v.title.replace(/"/g,'&quot;')%>" data-source="<%=v.source_value.replace(/"/g,'&quot;')%>" data-type="<%=v.source_type%>" data-duration="<%=v.duration_seconds||''%>" data-free="<%=v.is_free?'1':'0'%>">Sửa</button><form method="POST" action="/admin/video/<%=v.id%>/xoa" class="d-inline"><input type="hidden" name="parent_type" value="<%=parentType%>"><input type="hidden" name="parent_id" value="<%=entity.id%>"><button class="btn btn-sm btn-link text-danger">xóa</button></form></div></div><% }) %>
          <% l.files.forEach(f=>{ %><div class="resource d-flex justify-content-between align-items-center"><div><span class="text-danger">▣</span> <strong><%= f.title %></strong> <span class="badge bg-light text-dark"><%= f.file_type %></span> <% if(f.is_free){ %><span class="badge badge-free">Miễn phí</span><% }else{ %><span class="badge badge-lock">Có quyền</span><% } %></div><div><button class="btn btn-sm btn-link" data-bs-toggle="modal" data-bs-target="#editFileModal" data-id="<%=f.id%>" data-title="<%=f.title.replace(/"/g,'&quot;')%>" data-url="<%=f.file_url.replace(/"/g,'&quot;')%>" data-free="<%=f.is_free?'1':'0'%>">Sửa</button><form method="POST" action="/admin/tai-lieu/<%=f.id%>/xoa" class="d-inline"><input type="hidden" name="parent_type" value="<%=parentType%>"><input type="hidden" name="parent_id" value="<%=entity.id%>"><button class="btn btn-sm btn-link text-danger">xóa</button></form></div></div><% }) %>
        </div>
      </article>
      <% }) %>
      <% if(!ch.lessons.length){ %><div class="p-3 text-muted small">Chưa có bài. Kéo bài từ chương khác vào đây hoặc bấm ＋ Bài học.</div><% } %>
    </div>
  </section>
<% }) %>
</div>
<% if(!chapters.length){ %><div class="card p-5 text-center text-muted">Chưa có chương. Hãy tạo chương đầu tiên.</div><% } %>

<!-- chapter modal -->
<div class="modal fade" id="chapterModal"><div class="modal-dialog"><div class="modal-content"><form method="POST" action="/admin/chuong"><div class="modal-header"><h5>Thêm chương</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="parent_type" value="<%=parentType%>"><input type="hidden" name="parent_id" value="<%=entity.id%>"><input name="title" class="form-control" placeholder="Ví dụ: Chương I. Hàm số" required></div><div class="modal-footer"><button class="btn btn-primary">Thêm chương</button></div></form></div></div></div>
<div class="modal fade" id="editChapterModal"><div class="modal-dialog"><div class="modal-content"><form method="POST" id="editChapterForm"><div class="modal-header"><h5>Sửa chương</h5></div><div class="modal-body"><input type="hidden" name="parent_type" value="<%=parentType%>"><input type="hidden" name="parent_id" value="<%=entity.id%>"><input name="title" id="editChapterTitle" class="form-control" required></div><div class="modal-footer"><button class="btn btn-primary">Lưu</button></div></form></div></div></div>
<div class="modal fade" id="lessonModal"><div class="modal-dialog"><div class="modal-content"><form method="POST" action="/admin/bai-hoc"><div class="modal-header"><h5>Thêm bài học</h5></div><div class="modal-body"><input type="hidden" name="parent_type" value="<%=parentType%>"><input type="hidden" name="parent_id" value="<%=entity.id%>"><input type="hidden" name="chapter_id" id="lessonChapterId"><input name="title" class="form-control mb-2" placeholder="Tên bài" required><textarea name="content" class="form-control mb-2" rows="3" placeholder="Mô tả/nội dung bài"></textarea><div class="form-check"><input type="checkbox" name="is_preview" class="form-check-input"><label class="form-check-label">Cho học thử miễn phí</label></div></div><div class="modal-footer"><button class="btn btn-primary">Thêm bài</button></div></form></div></div></div>
<div class="modal fade" id="editLessonModal"><div class="modal-dialog"><div class="modal-content"><form method="POST" id="editLessonForm"><div class="modal-header"><h5>Sửa bài học</h5></div><div class="modal-body"><input type="hidden" name="parent_type" value="<%=parentType%>"><input type="hidden" name="parent_id" value="<%=entity.id%>"><input name="title" id="editLessonTitle" class="form-control mb-2" required><textarea name="content" id="editLessonContent" class="form-control mb-2" rows="4"></textarea><div class="form-check"><input type="checkbox" name="is_preview" id="editLessonPreview" class="form-check-input"><label class="form-check-label">Cho học thử miễn phí</label></div></div><div class="modal-footer"><button class="btn btn-primary">Lưu</button></div></form></div></div></div>
<div class="modal fade" id="videoModal"><div class="modal-dialog"><div class="modal-content"><form method="POST" action="/admin/video" enctype="multipart/form-data"><div class="modal-header"><h5>Thêm video</h5></div><div class="modal-body"><input type="hidden" name="parent_type" value="<%=parentType%>"><input type="hidden" name="parent_id" value="<%=entity.id%>"><input type="hidden" name="lesson_id" id="videoLessonId"><input name="title" class="form-control mb-2" placeholder="Tên video" required><select name="source_type" id="videoSourceType" class="form-select mb-2"><option value="youtube">YouTube</option><option value="vimeo">Vimeo</option><option value="drive">Google Drive</option><option value="upload">Upload MP4</option></select><input name="source_value" id="videoSourceValue" class="form-control mb-2" placeholder="Dán link video"><input type="file" name="video_file" id="videoFile" class="form-control mb-2 d-none" accept="video/mp4,video/webm"><div class="row"><div class="col"><label class="form-label">Thời lượng (giây) <span class="text-muted">tùy chọn</span></label><input type="number" min="0" name="duration_seconds" class="form-control"></div><div class="col d-flex align-items-end"><div class="form-check mb-2"><input type="checkbox" name="is_free" class="form-check-input"><label class="form-check-label">Video miễn phí</label></div></div></div><div class="muted-note mt-2">Không cần nhập thời lượng nếu bạn không dùng thống kê tiến độ.</div></div><div class="modal-footer"><button class="btn btn-primary">Thêm video</button></div></form></div></div></div>
<div class="modal fade" id="editVideoModal"><div class="modal-dialog"><div class="modal-content"><form method="POST" id="editVideoForm"><div class="modal-header"><h5>Sửa video</h5></div><div class="modal-body"><input type="hidden" name="parent_type" value="<%=parentType%>"><input type="hidden" name="parent_id" value="<%=entity.id%>"><input name="title" id="editVideoTitle" class="form-control mb-2" required><select name="source_type" id="editVideoType" class="form-select mb-2"><option value="youtube">YouTube</option><option value="vimeo">Vimeo</option><option value="drive">Google Drive</option><option value="upload">Upload</option></select><input name="source_value" id="editVideoSource" class="form-control mb-2"><input type="number" min="0" name="duration_seconds" id="editVideoDuration" class="form-control mb-2"><div class="form-check"><input type="checkbox" name="is_free" id="editVideoFree" class="form-check-input"><label class="form-check-label">Video miễn phí</label></div></div><div class="modal-footer"><button class="btn btn-primary">Lưu</button></div></form></div></div></div>
<div class="modal fade" id="fileModal"><div class="modal-dialog"><div class="modal-content"><form method="POST" action="/admin/tai-lieu" enctype="multipart/form-data"><div class="modal-header"><h5>Thêm tài liệu</h5></div><div class="modal-body"><input type="hidden" name="parent_type" value="<%=parentType%>"><input type="hidden" name="parent_id" value="<%=entity.id%>"><input type="hidden" name="lesson_id" id="fileLessonId"><input name="title" class="form-control mb-2" placeholder="Tên tài liệu" required><input name="file_url" class="form-control mb-2" placeholder="Link Drive/PDF (hoặc tải file bên dưới)"><div class="small text-muted mb-2">Link được ưu tiên nếu có. Nếu không có, chọn file tối đa 50MB.</div><input type="file" name="file" class="form-control mb-2" accept=".pdf,.doc,.docx,.zip,.ppt,.pptx"><div class="form-check"><input type="checkbox" name="is_free" class="form-check-input"><label class="form-check-label">Tài liệu miễn phí</label></div></div><div class="modal-footer"><button class="btn btn-primary">Thêm tài liệu</button></div></form></div></div></div>
<div class="modal fade" id="editFileModal"><div class="modal-dialog"><div class="modal-content"><form method="POST" id="editFileForm" enctype="multipart/form-data"><div class="modal-header"><h5>Sửa tài liệu</h5></div><div class="modal-body"><input type="hidden" name="parent_type" value="<%=parentType%>"><input type="hidden" name="parent_id" value="<%=entity.id%>"><input name="title" id="editFileTitle" class="form-control mb-2" required><input name="file_url" id="editFileUrl" class="form-control mb-2"><input type="file" name="file" class="form-control mb-2"><div class="form-check"><input type="checkbox" name="is_free" id="editFileFree" class="form-check-input"><label class="form-check-label">Tài liệu miễn phí</label></div></div><div class="modal-footer"><button class="btn btn-primary">Lưu</button></div></form></div></div></div>

<script>
function postJSON(url,body){return fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(r=>{if(!r.ok)throw new Error('HTTP '+r.status);return r.json();});}
const chapterList=document.getElementById('chapterList');
if(chapterList)new Sortable(chapterList,{handle:'.chapter-handle',animation:150,onEnd:()=>{const ids=[...chapterList.querySelectorAll(':scope > .chapter-card')].map(x=>x.dataset.id);postJSON('/admin/chuong/sap-xep',{ids}).catch(()=>location.reload());}});
document.querySelectorAll('.lesson-list').forEach(list=>new Sortable(list,{group:'lessons',handle:'.lesson-handle',animation:150,onEnd:()=>{const ids=[...list.querySelectorAll('.lesson-row')].map(x=>x.dataset.id);postJSON('/admin/bai-hoc/sap-xep',{ids}).catch(()=>location.reload());}}));
document.getElementById('lessonModal').addEventListener('show.bs.modal',e=>document.getElementById('lessonChapterId').value=e.relatedTarget.dataset.chapter);
document.getElementById('editChapterModal').addEventListener('show.bs.modal',e=>{document.getElementById('editChapterForm').action='/admin/chuong/'+e.relatedTarget.dataset.id;document.getElementById('editChapterTitle').value=e.relatedTarget.dataset.title;});
document.getElementById('editLessonModal').addEventListener('show.bs.modal',e=>{const b=e.relatedTarget;document.getElementById('editLessonForm').action='/admin/bai-hoc/'+b.dataset.id;document.getElementById('editLessonTitle').value=b.dataset.title;document.getElementById('editLessonContent').value=b.dataset.content;document.getElementById('editLessonPreview').checked=b.dataset.preview==='1';});
document.getElementById('videoModal').addEventListener('show.bs.modal',e=>document.getElementById('videoLessonId').value=e.relatedTarget.dataset.lesson);
document.getElementById('videoSourceType').addEventListener('change',e=>{const u=e.target.value==='upload';document.getElementById('videoFile').classList.toggle('d-none',!u);document.getElementById('videoSourceValue').classList.toggle('d-none',u);});
document.getElementById('editVideoModal').addEventListener('show.bs.modal',e=>{const b=e.relatedTarget;document.getElementById('editVideoForm').action='/admin/video/'+b.dataset.id;document.getElementById('editVideoTitle').value=b.dataset.title;document.getElementById('editVideoType').value=b.dataset.type;document.getElementById('editVideoSource').value=b.dataset.source;document.getElementById('editVideoDuration').value=b.dataset.duration;document.getElementById('editVideoFree').checked=b.dataset.free==='1';});
document.getElementById('fileModal').addEventListener('show.bs.modal',e=>document.getElementById('fileLessonId').value=e.relatedTarget.dataset.lesson);
document.getElementById('editFileModal').addEventListener('show.bs.modal',e=>{const b=e.relatedTarget;document.getElementById('editFileForm').action='/admin/tai-lieu/'+b.dataset.id;document.getElementById('editFileTitle').value=b.dataset.title;document.getElementById('editFileUrl').value=b.dataset.url;document.getElementById('editFileFree').checked=b.dataset.free==='1';});
</script>
<%- include('../../partials/admin-footer') %>
