<% var pageTitle='Bài tự luyện: '+lesson.title %><%- include('../../partials/admin-header') %>
<div class="d-flex justify-content-between align-items-center mb-3"><div><div class="small text-muted">Sách · Bài học</div><h5 class="fw-bold mb-0"><%=lesson.title%></h5></div><a href="/admin/sach/<%=lesson.book_id%>/noi-dung" class="btn btn-outline-secondary btn-sm">← Quay lại nội dung sách</a></div>
<%if(!quiz){%><div class="card p-4 border-0 shadow-sm"><h5>Tạo bài tự luyện</h5><p class="text-muted">Bài tự luyện nằm trong từng bài học của sách, tách biệt với phòng thi.</p><form method="post" action="/admin/sach/bai-tu-luyen" class="row g-2"><input type="hidden" name="lesson_id" value="<%=lesson.id%>"><div class="col-md-7"><input name="title" class="form-control" value="Bài tự luyện - <%=lesson.title%>" required></div><div class="col-md-3"><input name="pass_score" type="number" step="0.1" class="form-control" value="5" placeholder="Điểm đạt"></div><div class="col-md-2"><button class="btn btn-primary w-100">Tạo</button></div></form></div><%}else{%>
<div class="card p-4 border-0 shadow-sm mb-3"><div class="d-flex justify-content-between"><div><h5 class="fw-bold"><%=quiz.title%></h5><div class="small text-muted">Điểm đạt: <%=quiz.pass_score%></div></div><form method="post" action="/admin/sach/bai-tu-luyen/<%=quiz.id%>/xoa"><input type="hidden" name="lesson_id" value="<%=lesson.id%>"><button class="btn btn-outline-danger btn-sm">Xóa bài tự luyện</button></form></div></div>
<div class="card p-4 border-0 shadow-sm mb-3"><h6 class="fw-bold">Thêm câu hỏi trắc nghiệm</h6><form method="post" action="/admin/sach/bai-tu-luyen/cau-hoi"><input type="hidden" name="quiz_id" value="<%=quiz.id%>"><input type="hidden" name="lesson_id" value="<%=lesson.id%>"><textarea name="question" class="form-control mb-2" rows="3" placeholder="Nội dung câu hỏi" required></textarea><div class="row g-2"><div class="col-md-6"><input name="option_a" class="form-control" placeholder="A. ..." required></div><div class="col-md-6"><input name="option_b" class="form-control" placeholder="B. ..." required></div><div class="col-md-6"><input name="option_c" class="form-control" placeholder="C. ..."></div><div class="col-md-6"><input name="option_d" class="form-control" placeholder="D. ..."></div><div class="col-md-4"><select name="correct_index" class="form-select"><option value="0">Đáp án A</option><option value="1">Đáp án B</option><option value="2">Đáp án C</option><option value="3">Đáp án D</option></select></div><div class="col-md-8"><button class="btn btn-primary">+ Thêm câu hỏi</button></div></div></form></div>
<div class="card border-0 shadow-sm"><div class="card-header bg-white fw-bold">Danh sách câu hỏi</div><div class="card-body"><%quiz.questions.forEach((q,i)=>{%><div class="border-bottom py-3"><b>Câu <%=i+1%>.</b> <%=q.question%><div class="small mt-2"><%q.options.forEach((o,j)=>{%><span class="badge <%=o.is_correct?'bg-success':'bg-light text-dark'%> me-1"><%=String.fromCharCode(65+j)%>. <%=o.option_text%><%=o.is_correct?' ✓':''%></span><%})%></div></div><%})%><%if(!quiz.questions.length){%><div class="text-muted">Chưa có câu hỏi.</div><%}%></div></div>
<%}%><%- include('../../partials/admin-footer') %>
