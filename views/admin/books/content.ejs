<% var pageTitle='Nội dung sách: '+book.title %>
<%- include('../../partials/admin-header') %>
<div class="alert alert-info">Sách được thiết kế như một sản phẩm học tập: <b>Chương → Bài → Video/Tài liệu → Bài tự luyện</b>. Việc mua/kích hoạt sách chỉ mở nội dung; không biến cả cuốn sách thành một video duy nhất.</div>
<button class="btn btn-primary mb-3" data-bs-toggle=modal data-bs-target=#chapterModal>+ Thêm chương</button>
<div id=chapters>
<%chapters.forEach(ch=>{%><div class="card p-3 mb-3" data-id="<%=ch.id%>"><div class="d-flex justify-content-between"><h5><i class="fa-solid fa-grip-vertical drag-handle"></i> <%=ch.title%></h5><form method=post action="/admin/sach/chuong/<%=ch.id%>/xoa"><input type=hidden name=book_id value="<%=book.id%>"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></div>
<% const ls=lessons.filter(l=>l.chapter_id===ch.id); %><div class="list-group mb-2"><%ls.forEach(l=>{%><div class="list-group-item"><div class="d-flex justify-content-between"><div><b><%=l.title%></b> <%if(l.is_preview){%><span class="badge bg-success">Học thử</span><%}%></div><button class="btn btn-sm btn-outline-secondary" data-bs-toggle=modal data-bs-target=#videoModal data-lesson="<%=l.id%>">+ Video</button><button class="btn btn-sm btn-outline-secondary" data-bs-toggle=modal data-bs-target=#fileModal data-lesson="<%=l.id%>">+ Tài liệu</button><a href="/sach/hoc/<%=l.id%>" class="btn btn-sm btn-outline-primary">Xem</a><form method=post action="/admin/sach/bai-hoc/<%=l.id%>/xoa" class=d-inline><input type=hidden name=book_id value="<%=book.id%>"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></div></div></div><%})%></div>
<button class="btn btn-sm btn-outline-secondary" data-bs-toggle=modal data-bs-target=#lessonModal data-chapter="<%=ch.id%>">+ Bài học</button></div><%})%>
</div>
<div class="modal fade" id=chapterModal><div class=modal-dialog><div class=modal-content><form method=post action="/admin/sach/chuong"><div class=modal-body><input type=hidden name=book_id value="<%=book.id%>"><input name=title class=form-control placeholder="Tên chương" required></div><div class=modal-footer><button class="btn btn-primary">Thêm</button></div></form></div></div></div>
<div class="modal fade" id=lessonModal><div class=modal-dialog><div class=modal-content><form method=post action="/admin/sach/bai-hoc"><div class=modal-body><input type=hidden name=book_id value="<%=book.id%>"><input type=hidden id=chapterId name=chapter_id><input name=title class=form-control placeholder="Tên bài học" required><textarea name=content class="form-control mt-2" rows=4 placeholder="Nội dung bài học"></textarea><label class="form-check mt-2"><input type=checkbox name=is_preview class=form-check-input> Cho học thử</label></div><div class=modal-footer><button class="btn btn-primary">Thêm</button></div></form></div></div></div>

<div class="modal fade" id=videoModal><div class=modal-dialog><div class=modal-content><form method=post action="/admin/sach/video" enctype=multipart/form-data><div class=modal-body><input type=hidden name=book_id value="<%=book.id%>"><input type=hidden name=lesson_id id=bookVideoLesson><input name=title class=form-control placeholder="Tên video" required><select name=source_type class="form-select mt-2"><option value=youtube>YouTube</option><option value=vimeo>Vimeo</option><option value=drive>Google Drive</option><option value=upload>Upload MP4</option></select><input name=source_value class="form-control mt-2" placeholder="Link video"><input type=file name=video_file class="form-control mt-2" accept="video/mp4"><div class="row mt-2"><div class=col><input name=duration_seconds type=number class=form-control placeholder="Thời lượng giây"></div><div class=col><label class=form-check><input type=checkbox name=is_free class=form-check-input> Miễn phí</label></div></div></div><div class=modal-footer><button class="btn btn-primary">Lưu video</button></div></form></div></div></div>
<div class="modal fade" id=fileModal><div class=modal-dialog><div class=modal-content><form method=post action="/admin/sach/tai-lieu" enctype=multipart/form-data><div class=modal-body><input type=hidden name=book_id value="<%=book.id%>"><input type=hidden name=lesson_id id=bookFileLesson><input name=title class=form-control placeholder="Tên tài liệu" required><input type=file name=file class="form-control mt-2"><input name=file_url_link class="form-control mt-2" placeholder="Hoặc link Drive/PDF"><label class=form-check mt-2><input type=checkbox name=is_free class=form-check-input> Miễn phí</label></div><div class=modal-footer><button class="btn btn-primary">Lưu tài liệu</button></div></form></div></div></div>
<script>document.getElementById('videoModal').addEventListener('show.bs.modal',e=>document.getElementById('bookVideoLesson').value=e.relatedTarget.dataset.lesson);document.getElementById('fileModal').addEventListener('show.bs.modal',e=>document.getElementById('bookFileLesson').value=e.relatedTarget.dataset.lesson);document.getElementById('lessonModal').addEventListener('show.bs.modal',e=>document.getElementById('chapterId').value=e.relatedTarget.dataset.chapter);new Sortable(document.getElementById('chapters'),{handle:'.drag-handle',onEnd:()=>fetch('/admin/sach/chuong/sap-xep',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids:[...document.querySelectorAll('#chapters>[data-id]')].map(x=>x.dataset.id)})})});</script>
<%- include('../../partials/admin-footer') %>