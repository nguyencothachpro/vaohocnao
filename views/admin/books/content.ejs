<% var pageTitle='Nội dung sách: '+book.title %><%- include('../../partials/admin-header') %>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><div class="small text-muted">Sản phẩm học tập</div><h5 class="fw-bold mb-0"><%=book.title%></h5></div><div class="d-flex gap-2"><a href="/admin/sach" class="btn btn-outline-secondary btn-sm">← Danh sách sách</a><button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#chapterModal">+ Thêm chương</button></div></div>
<div class="alert alert-info small"><b>Sách không phải một video.</b> Cấu trúc đúng là <b>Chương → Bài → Video / Tài liệu / Bài tự luyện</b>. Bạn có thể kéo thả chương để sắp xếp; mỗi bài có thể miễn phí/học thử và mỗi video/tài liệu có thể đặt miễn phí riêng.</div>
<div id="chapters"><%chapters.forEach((ch,ci)=>{const ls=lessons.filter(l=>l.chapter_id===ch.id);%><div class="card border-0 shadow-sm mb-3" data-id="<%=ch.id%>"><div class="card-header bg-white p-3 d-flex justify-content-between align-items-center"><div><span class="drag-handle text-muted me-2">☷</span><span class="badge bg-primary me-2"><%=ci+1%></span><b><%=ch.title%></b><span class="small text-muted ms-2"><%=ls.length%> bài</span></div><div><button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#lessonModal" data-chapter="<%=ch.id%>">+ Bài học</button><form method="post" action="/admin/sach/chuong/<%=ch.id%>/xoa" class="d-inline"><input type="hidden" name="book_id" value="<%=book.id%>"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></div></div><div class="card-body p-2"><div class="list-group">
<%ls.forEach((l,li)=>{%><div class="list-group-item p-3"><div class="d-flex justify-content-between align-items-start"><div><b><%=li+1%>. <%=l.title%></b> <%if(l.is_preview){%><span class="badge bg-success">Học thử</span><%}%><div class="small text-muted mt-1"><%=l.videos.length%> video · <%=l.files.length%> tài liệu</div></div><div class="d-flex gap-1 flex-wrap justify-content-end"><button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#videoModal" data-lesson="<%=l.id%>">+ Video</button><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#fileModal" data-lesson="<%=l.id%>">+ Tài liệu</button><a class="btn btn-sm btn-outline-warning" href="/admin/sach/bai-hoc/<%=l.id%>/bai-tu-luyen">📝 <%=l.quiz?'Sửa tự luyện':'Tạo tự luyện'%></a><a href="/sach/hoc/<%=l.id%>" class="btn btn-sm btn-outline-success">Xem</a><form method="post" action="/admin/sach/bai-hoc/<%=l.id%>/xoa" class="d-inline"><input type="hidden" name="book_id" value="<%=book.id%>"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></div></div><div class="mt-2 small"><%l.videos.forEach(v=>{%><div class="py-1"><i class="fa-solid fa-video text-primary me-1"></i><%=v.title%> <span class="badge bg-light text-dark"><%=v.source_type%></span><%if(v.duration_seconds){%><span class="badge bg-secondary"><%=Math.floor(v.duration_seconds/60)%> phút <%=v.duration_seconds%> giây</span><%}%><%if(v.is_free){%><span class="badge bg-success">Miễn phí</span><%}%></div><%})%><%l.files.forEach(f=>{%><div class="py-1"><i class="fa-solid fa-file-pdf text-danger me-1"></i><%=f.title%><%if(f.is_free){%><span class="badge bg-success">Miễn phí</span><%}%></div><%})%></div></div><%})%>
</div></div></div><%})%><%if(!chapters.length){%><div class="card p-5 text-center border-0 shadow-sm"><h5>Chưa có chương</h5><p class="text-muted">Thêm chương đầu tiên để bắt đầu xây sách như một khóa học.</p></div><%}%></div>
<div class="modal fade" id="chapterModal"><div class="modal-dialog"><div class="modal-content"><form method="post" action="/admin/sach/chuong"><div class="modal-body"><input type="hidden" name="book_id" value="<%=book.id%>"><input name="title" class="form-control" placeholder="Tên chương" required></div><div class="modal-footer"><button class="btn btn-primary">Thêm chương</button></div></form></div></div></div>
<div class="modal fade" id="lessonModal"><div class="modal-dialog"><div class="modal-content"><form method="post" action="/admin/sach/bai-hoc"><div class="modal-body"><input type="hidden" name="book_id" value="<%=book.id%>"><input type="hidden" name="chapter_id" id="chapterId"><input name="title" class="form-control mb-2" placeholder="Tên bài học" required><textarea name="content" class="form-control mb-2" rows="4" placeholder="Nội dung bài học"></textarea><label class="form-check"><input type="checkbox" name="is_preview" class="form-check-input"> Cho học thử miễn phí</label></div><div class="modal-footer"><button class="btn btn-primary">Thêm bài</button></div></form></div></div></div>
<div class="modal fade" id="videoModal"><div class="modal-dialog"><div class="modal-content"><form method="post" action="/admin/sach/video" enctype="multipart/form-data"><div class="modal-body"><input type="hidden" name="book_id" value="<%=book.id%>"><input type="hidden" name="lesson_id" id="bookVideoLesson"><input name="title" class="form-control mb-2" placeholder="Tên video" required><select name="source_type" class="form-select mb-2"><option value="youtube">YouTube</option><option value="vimeo">Vimeo</option><option value="drive">Google Drive</option><option value="upload">Upload MP4</option></select><input name="source_value" class="form-control mb-2" placeholder="Link video"><input type="file" name="video_file" class="form-control mb-2" accept="video/mp4"><div class="row"><div class="col"><label class="form-label small">Thời lượng (giây, tùy chọn)</label><input name="duration_seconds" type="number" min="0" class="form-control"></div><div class="col d-flex align-items-end"><label class="form-check"><input type="checkbox" name="is_free" class="form-check-input"> Miễn phí</label></div></div></div><div class="modal-footer"><button class="btn btn-primary">Lưu video</button></div></form></div></div></div>
<div class="modal fade" id="fileModal"><div class="modal-dialog"><div class="modal-content"><form method="post" action="/admin/sach/tai-lieu" enctype="multipart/form-data"><div class="modal-body"><input type="hidden" name="book_id" value="<%=book.id%>"><input type="hidden" name="lesson_id" id="bookFileLesson"><input name="title" class="form-control mb-2" placeholder="Tên tài liệu" required><input type="file" name="file" class="form-control mb-2"><input name="file_url_link" class="form-control mb-2" placeholder="Hoặc link Drive/PDF"><label class="form-check"><input type="checkbox" name="is_free" class="form-check-input"> Miễn phí</label></div><div class="modal-footer"><button class="btn btn-primary">Lưu tài liệu</button></div></form></div></div></div>
<script>document.getElementById('videoModal').addEventListener('show.bs.modal',e=>document.getElementById('bookVideoLesson').value=e.relatedTarget.dataset.lesson);document.getElementById('fileModal').addEventListener('show.bs.modal',e=>document.getElementById('bookFileLesson').value=e.relatedTarget.dataset.lesson);document.getElementById('lessonModal').addEventListener('show.bs.modal',e=>document.getElementById('chapterId').value=e.relatedTarget.dataset.chapter);new Sortable(document.getElementById('chapters'),{handle:'.drag-handle',animation:150,onEnd:()=>fetch('/admin/sach/chuong/sap-xep',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids:[...document.querySelectorAll('#chapters>[data-id]')].map(x=>x.dataset.id)})})});</script><%- include('../../partials/admin-footer') %>
