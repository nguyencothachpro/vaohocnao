<% var pageTitle='Bổ sung thông tin' %><%- include('../partials/header') %>
<div class="row justify-content-center"><div class="col-md-7"><div class="card p-4"><h4 class=fw-bold>Hoàn thiện hồ sơ học viên</h4><p class=text-muted>Thông tin này giúp quản trị viên quản lý lớp học và cấp quyền học chính xác.</p><%if(error){%><div class="alert alert-danger"><%=error%></div><%}%>
<form method=post action="/tai-khoan/ho-so"><label class=form-label>Họ tên</label><input name=name class=form-control value="<%=user.name||''%>" required><label class=form-label>Số điện thoại</label><input name=phone class=form-control value="<%=user.phone||''%>" required><label class=form-label>Ngày sinh</label><input name=birth_date type=date class=form-control value="<%=user.birth_date?new Date(user.birth_date).toISOString().slice(0,10):''%>" required><label class=form-label>Email</label><input class=form-control value="<%=user.email%>" disabled><button class="btn btn-primary mt-3">Lưu thông tin</button></form></div></div></div><%- include('../partials/footer') %>